<div class="product flex flex-col items-center justify-between text-center bg-gray-50 p-4 rounded-lg shadow-md w-36 transition duration-300 ease-in-out hover:bg-gray-200 ">
    <!-- Product Name -->
    <span class="text-sm font-bold text-gray-700 mb-2 h-10 overflow-hidden">@Product.Name</span>
    
    <!-- Image -->
    @* todo: add default image when not provided? *@
    <img src="@ImageUrl" alt="Item Image" class="h-32 w-32 object-contain mb-2 cursor-pointer" @onclick="OnClick">

    <!-- Barcode 
    <span class="text-sm font-light text-gray-350 mb-2">@Product.Barcode</span>-->

    <!-- Amount In Stock -->
    <span class="font-bold text-gray-900 @(Product.QuantityInStock == 0 ? "text-xl" : "text-3xl") mb-2">
        @(Product.QuantityInStock == 0 ? "Uit voorraad" : Product.QuantityInStock.ToString())
    </span>

    <!-- Button Uitlenen -->
    <button class="bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-md" @onclick="NavigateToScan">
        Uitscannen
    </button>
</div>
