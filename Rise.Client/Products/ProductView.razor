
<div class="product flex flex-col items-center justify-center bg-gray-50 p-4 rounded-lg shadow-md w-36 transition duration-300 ease-in-out hover:bg-gray-200 ">
    <!-- Top Text -->
    <span class="text-sm font-bold text-gray-700 mb-2">@BarCode</span>
    
    <!-- Image -->
    <img src="@ImageUrl" alt="Item Image" class="h-32 w-32 object-contain mb-2 cursor-pointer" @onclick="OnClick">

    <!-- Number below the image -->
    <span class="text-3xl font-bold text-gray-900 mb-2">@QuantityInStock</span>

    <!-- Button -->
    <button class="bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-md">
        Uitlenen
    </button>
</div>

@code {
    [Parameter] public string BarCode { get; set; }
    [Parameter] public string ImageUrl { get; set; }
    [Parameter] public int QuantityInStock { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }
}