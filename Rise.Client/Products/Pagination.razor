<div class="pagination-container mb-4 py-2 px-2 flex items-center justify-between mx-auto @(IsColumnTable ? "w-full lg:w-3/4 bg-transparent border-none shadow-none" : "w-full bg-gray-200 border border-gray-200 shadow-md rounded-t-lg")">
    <div class="text-gray-500">
        Pagina @CurrentPage van @TotalPages
    </div>

    <div class="flex items-center space-x-1">
        <select @onchange="OnPageSizeChange" class="border border-gray-200 bg-gray-200 text-gray-500 rounded-lg py-1 px-2 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm">
            @foreach (var pageSize in PageSizes)
            {
                <option value="@pageSize" selected="@(CurrentPageSize == pageSize ? "selected" : null)">@pageSize per pagina</option>
            }
        </select>

        <button class="bg-gray-200 text-gray-500 px-2 py-1 rounded hover:bg-gray-300 disabled:opacity-50 border border-gray-200"
                @onclick="GoToPreviousPage" disabled="@IsFirstPage">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18" />
            </svg>
        </button>

        <button class="bg-gray-200 text-gray-500 px-2 py-1 rounded hover:bg-gray-300 disabled:opacity-50 border border-gray-200"
                @onclick="GoToNextPage" disabled="@IsLastPage">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
            </svg>
        </button>
    </div>
</div>
