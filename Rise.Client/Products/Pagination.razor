<div class="pagination-container bg-gray-100 py-2 px-4 rounded-md flex justify-between items-center shadow-md">
    <span class="text-gray-700">Page @CurrentPage of @TotalPages</span>
    <div>
        <button class="bg-gray-200 text-gray-600 px-4 py-2 mr-2 rounded-md hover:bg-gray-400 disabled:opacity-50"
                @onclick="GoToPreviousPage">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18" />
            </svg>

        </button>
        <button class="bg-gray-200 text-gray-600 px-4 py-2 rounded-md hover:bg-gray-400 disabled:opacity-50"
                @onclick="GoToNextPage">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
            </svg>

        </button>
    </div>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private bool IsFirstPage => CurrentPage <= 1;
    private bool IsLastPage => CurrentPage >= TotalPages;

    private async Task GoToPreviousPage()
    {
        Console.WriteLine($"Current Page: {CurrentPage}, Total Pages: {TotalPages}");
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await OnPageChanged.InvokeAsync(CurrentPage);
        }
    }

    private async Task GoToNextPage()
    {
       // if (CurrentPage < TotalPages)
        //{
        Console.WriteLine($"Current Page: {CurrentPage}, Total Pages: {TotalPages}");
            CurrentPage++;
            await OnPageChanged.InvokeAsync(CurrentPage);
       // }
    }

}
