@using Rise.Shared.Products
@using Microsoft.AspNetCore.Components

<div class="overflow-x-auto">
    <table class="min-w-full table-auto border-collapse border border-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quantity in stock</th>
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quantity on order</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Products)
            {
                <tr class="hover:bg-gray-100">
                    <td class="px-6 py-4 border-b border-gray-200">@product.Barcode</td>
                    <td class="px-6 py-4 border-b border-gray-200">@product.Name</td>
                    <td class="px-6 py-4 border-b border-gray-200">@product.QuantityInStock</td>
                    <td class="px-6 py-4 border-b border-gray-200">@product.QuantityOnOrder</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public required IEnumerable<ProductDto> Products { get; set; }
}
