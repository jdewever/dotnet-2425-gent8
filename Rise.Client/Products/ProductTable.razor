@using Rise.Shared.Products
@using Microsoft.AspNetCore.Components

<div class="overflow-x-auto rounded-lg">
    <table class="min-w-full table-auto border-collapse border border-gray-200 rounded-lg">
        <thead class="bg-gray-200">
            <tr>
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">Code</th> 
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">Naam</th>
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">In Stock</th>
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">Op Bestelling</th>
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">Lokaal</th>
                <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Products)
            {
                <tr class="hover:bg-gray-100">
                    <td class="px-6 py-2 border-b border-gray-200">@product.Barcode</td>
                    <td class="px-6 py-2 border-b border-gray-200">@product.Name</td>
                    <td class="px-6 py-2 border-b border-gray-200">@product.QuantityInStock</td>
                    <td class="px-6 py-2 border-b border-gray-200">@product.QuantityOnOrder</td>
                    <td class="px-6 py-2 border-b border-gray-200">@product.ClassRoomCode</td>
                    <td class="px-6 py-2 border-b border-gray-200">
                        <button class="bg-gray-200 text-gray-700 text-xs px-2 py-1 rounded-full hover:bg-gray-300">Uitlenen</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public required IEnumerable<ProductDto> Products { get; set; }
}
