@attribute [Authorize(Roles = "Administrator")]
@page "/products/add"

<h2 class="text-3xl font-bold text-center text-gray-900 mb-8">Toevoegen nieuw product</h2>


<body class="flex items-center justify-center min-h-screen">
    <div class="max-w-3xl">
        <div>
            <EditForm Model="@newProduct" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />

                <div class="grid md:grid-cols-1 md:gap-6">
                    <div class="grid md:grid-cols-1 md:gap-6">
                        <div>
                            <label for="name" class="block mb-2 text-sm font-medium text-gray-900">Naam</label>
                            <InputText @bind-Value="newProduct.Name" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="naam" />
                            <ValidationMessage For="@(() => newProduct.Name)" class="text-xs text-red-500 mt-0 p-0" />

                            <label for="location" class="block mb-2 text-sm font-medium text-gray-900 mt-5">Lokaal</label>
                            <InputText @bind-Value="newProduct.ClassRoomCode" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="lokaal" />
                            <ValidationMessage For="@(() => newProduct.ClassRoomCode)" class="text-xs text-red-500 mt-0 p-0" />

                            <label for="description" class="block mb-2 text-sm font-medium text-gray-900 mt-5">Omschrijving</label>
                            <InputTextArea @bind-Value="newProduct.Description" rows="4" class="resize-none block p-2.5 w-full text-sm text-gray-900 bg-gray-100 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500 h-[220px]" placeholder="omschrijving ..." />
                            <ValidationMessage For="@(() => newProduct.Description)" class="text-xs text-red-500 mt-0 p-0" />
                        </div>
                    </div>

                    <div class="grid md:grid-cols-2 md:gap-6">
                        <div>
                            <div>
                                <label for="barcodeImage" class="block mb-2 text-sm font-medium text-gray-900">Barcode</label>
                                @if (!string.IsNullOrEmpty(newProduct.Barcode))
                                {
                                    <img src="https://localhost:5001/api/barcodes/@barcode.Barcode/image" alt="Barcode" class="w-full h-auto" />
                                }
                                else
                                {
                                    <p class="text-sm text-gray-500">Geen barcode beschikbaar</p>
                                }
                            </div>
                        </div>
                        <div>
                            <label class="block mb-2 text-sm font-medium text-gray-900" for="user_avatar">Foto</label>
                            <InputFile OnChange="HandleFileSelected" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 cursor-pointer" />
                        </div>
                    </div>
                </div>

                <hr class="my-12 h-0.5 border-t-0 bg-neutral-200" />

                <div class="grid md:grid-cols-3 md:gap-6">
                    <div>
                        <label for="lowStock" class="block mb-2 text-sm font-medium text-gray-900 mt-5">Aantal toevoegen in stock</label>
                        <InputNumber @bind-Value="newProduct.QuantityInStock" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="aantal" />
                        <ValidationMessage For="@(() => newProduct.QuantityInStock)" class="text-xs text-red-500 mt-0 p-0" />
                    </div>
                    <div>
                        <label for="lowStock" class="block mb-2 text-sm font-medium text-gray-900 mt-5">Aantal nog op bestelling</label>
                        <InputNumber @bind-Value="newProduct.QuantityOnOrder" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="aantal" />
                        <ValidationMessage For="@(() => newProduct.QuantityOnOrder)" class="text-xs text-red-500 mt-0 p-0" />
                    </div>
                    <div>
                        <label for="lowStock" class="block mb-2 text-sm font-medium text-gray-900 mt-5">Min gewenste voorraad</label>
                        <InputNumber @bind-Value="newProduct.LowStock" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="aantal" />
                        <ValidationMessage For="@(() => newProduct.LowStock)" class="text-xs text-red-500 mt-0 p-0" />
                    </div>
                </div>

                <div class="grid md:grid-cols-3 md:gap-6 mt-5">
                    <div>
                        <div>
                            <InputCheckbox @bind-Value="newProduct.IsReservable" class="peer w-4 h-4 text-gray-300 bg-gray-100 border-gray-300 rounded focus:ring-gray-3000 mt-8 peer-checked:bg-gray-300 peer-checked:border-gray-300" />
                            <label for="checkbox-3" class="ms-2 text-sm font-medium mt-10">Product is reserveerbaar</label>
                        </div>
                        <div>
                            <InputCheckbox @bind-Value="newProduct.IsHidden" class="peer w-4 h-4 text-gray-300 bg-gray-100 border-gray-300 rounded focus:ring-gray-300 mt-8 peer-checked:bg-gray-300 peer-checked:border-gray-300" />
                            <label for="checkbox-3" class="ms-2 text-sm font-medium mt-10">Product verbergen</label>
                        </div>
                    </div>

                    <div>
                        <label for="categories" class="block mb-2 text-sm font-medium text-gray-900">Categorieën</label>
                        <div class="flex items-center justify-between">
                            <select @bind="selectedCategory" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                                <option value="">Selecteer categorie</option>
                                @foreach (var category in CategoryOptions.Where(c => !newProduct.CategoryIds.Contains(c.Id)))
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <button type="button" @onclick="AddCategory" class="text-blue-600 hover:text-blue-800 font-medium ml-2">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-11.25a.75.75 0 0 0-1.5 0v2.5h-2.5a.75.75 0 0 0 0 1.5h2.5v2.5a.75.75 0 0 0 1.5 0v-2.5h2.5a.75.75 0 0 0 0-1.5h-2.5v-2.5Z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                        @if (newProduct.CategoryIds.Count >= 3 && showCategoryError)
                        {
                            <p class="text-xs text-red-500 mt-2">Je kan maximaal 3 categorieën toekennen</p>
                        }
                        <label for="newCategory" class="block mb-2 text-sm font-medium text-gray-900 mt-5">Nieuwe categorie toevoegen</label>
                        <div class="flex items-center">
                            <InputText @bind-Value="newCategoryName" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Voer een nieuwe categorie in" />
                            <button type="button" @onclick="AddNewCategory" class="text-blue-600 hover:text-blue-800 font-medium ml-2">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-11.25a.75.75 0 0 0-1.5 0v2.5h-2.5a.75.75 0 0 0 0 1.5h2.5v2.5a.75.75 0 0 0 1.5 0v-2.5h2.5a.75.75 0 0 0 0-1.5h-2.5v-2.5Z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                        @if (showAddCategoryError)
                        {
                            <p class="text-xs text-red-500 mt-1">Naam is verplicht.</p>
                        }
                    </div>

                    <div class="flex-wrap gap-2 mt-4">
                        @foreach (var selectedCategory in newProduct.CategoryIds)
                        {
                            <div class="flex items-center bg-gray-200 px-3 py-1 rounded-full justify-between w-full mb-2">
                                <span>@CategoryOptions.FirstOrDefault(c => c.Id == selectedCategory)?.Name</span>
                                <button type="button" class="text-red-500" @onclick="() => RemoveCategory(selectedCategory)">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM6.75 9.25a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Z" clip-rule="evenodd" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                </div>
                <hr class="my-12 h-0.5 border-t-0 bg-neutral-200" />

                <div class="flex justify-center mb-5">
                    <button type="submit" class="bg-gray-200 text-gray-700 px-5 py-2 rounded-lg hover:bg-gray-300">Opslaan</button>
                </div>
            </EditForm>
        </div>
    </div>
</body>
