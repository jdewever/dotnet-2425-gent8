@page "/products"
@using Rise.Shared.Products

<PageTitle>Products</PageTitle>

@if (products == null || categories == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div>
        <BlazoredTypeahead SearchMethod="SearchCategory"
                           @bind-Values="_selectedCategoriesList"
                           EnableDropDown="true"
                           placeholder="Zoeken via categorie ...">
            <SelectedTemplate Context="category">
                @category.Name
            </SelectedTemplate>
            <ResultTemplate Context="category">
                @category.Name
            </ResultTemplate>
        </BlazoredTypeahead>
    </div>
    <div class="flex justify-center mb-8">
        <ProductTable Products="products" />
    </div>
    <div class="flex justify-center mb-8">
        <ProductTable2 Products="products"/>
    </div>

   // VOORBEELD: hiermee kan je de tabel hergebruiken met bepaalde kollomen die je niet wilt displayen
   // <ProductTable Products="products" ShowInStock="false" ShowOnOrder="false" ShowClassRoomCode="false" />
}


