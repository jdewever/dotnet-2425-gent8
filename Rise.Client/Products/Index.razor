@page "/products"

<PageTitle>Products</PageTitle>

@if (products == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Quantity in stock</th>
            <th>Quantity on order</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in products)
            {
                <tr>
                    <td>@product.Barcode</td>
                    <td>@product.Name</td>
                    <td>@product.QuantityInStock</td>
                    <td>@product.QuantityOnOrder</td>
                </tr>
            }
        </tbody>
    </table>
}