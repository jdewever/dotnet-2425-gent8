@page "/products"
@attribute [Authorize]
@using Rise.Shared.Products
@using Rise.Client.Components.Table
@using Rise.Client.Products.Components
@using Rise.Client.Products.Buttons

<PageTitle>Products</PageTitle>

@if (products == null || categories == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <div class="flex justify-center mb-8">
        <TableNavbar OnShowColumnTable="showColumnTable" OnShowRegularTable="showRegularTable" Categories="categories"
            SelectedCategoriesIds="_selectedCategories" Location="@Location" Locations="_locations" MaxInStock="MaxInStock"
            MaxOnOrder="MaxOnOrder" MinInStock="MinInStock" MinOnOrder="MinOnOrder" OnFilterApplied="SetCurrentPageToOne"
            OnlyReservable="OnlyReservable"/>
        <input type="text" placeholder="zoektermen" @oninput="OnSearchInput"
            class="border border-gray-300 rounded-lg py-2 px-4 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <AuthorizeView Roles="Administrator, Invertorymanager">
            <AddProductButton />
        </AuthorizeView>
    </div>

    @if (!isColumnTable)
    {
        <div class="overflow-x-auto w-full">
            <Table Items="products" OnSelectRow="EventCallback.Factory.Create<ProductDTO>(this, ShowModal)">
                <Columns>
                    <AuthorizeView Roles="Administrator, Inventory Manager">
                        <Column T="ProductDTO" Value="Barcode" Title="Code" />
                    </AuthorizeView>
                    <Column T="ProductDTO" Value="Name" Title="Naam" />
                    <Column T="ProductDTO" Value="Description" Title="Beschrijving" />
                    <Column T="ProductDTO" Value="QuantityInStock" Title="In Stock" />
                    <AuthorizeView Roles="Administrator, Inventory Manager">
                        <Column T="ProductDTO" Value="QuantityOnOrder" Title="In Bestelling" />
                    </AuthorizeView>
                    <Column T="ProductDTO" Value="ClassRoomCode" Title="Lokaal" />
                </Columns>
                <Actions>
                    @if (OnlyReservable)
                    {
                        <TAction T="ProductDTO" Name="Reserveren" Method="OnReserverenClick" />
                    } else {
                        <TAction T="ProductDTO" Name="Uitlenen" Method="OnUitlenenClick" />
                    }
                </Actions>
            </Table>
        </div>

        @if (selectedProduct != null)
        {
            <ProductDetailModal SelectedProduct="selectedProduct" OnClick="CloseModal" Reserve="OnlyReservable" />
        }
    } else {
        <div class="flex justify-center mb-8">
            <ProductColumnView Products="products.ToList()" Reserve="OnlyReservable" />
        </div>
    }

    <Pagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" CurrentPageSize="@PageSize"
        OnPageChanged="HandlePageChanged" OnPageSizeChanged="HandlePageSizeChanged" IsColumnTable="isColumnTable" />
}
