@page "/products"
@using Rise.Shared.Products

<PageTitle>Products</PageTitle>

@if (products == null)
{   
    <p class="text-gray-500 text-center"><em>Loading...</em></p>
}
else
{
    <div class="overflow-x-auto w-full">
        <Table Items="products">
            <Columns>
                <Column Name="Barcode" Label="Code" />
                <Column Name="Name" Label="Naam" />
                <Column Name="Description" Label="Beschrijving" />
                <Column Name="QuantityInStock" Label="In Stock" />
                <Column Name="QuantityOnOrder" Label="In Bestelling" />
                <Column Name="ClassRoomCode" Label="Lokaal" />
                <Column Label="">
                    <button class="bg-gray-200 text-gray-700 text-xs px-2 py-1 rounded-full hover:bg-gray-300" disabled>
                        Uitlenen
                    </button>
                </Column>
            </Columns>
        </Table>
    </div>
}
