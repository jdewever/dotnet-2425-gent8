@using Rise.Shared.Products

<div class="fixed inset-0 flex items-center justify-center z-50">
    <div class="fixed inset-0 bg-black opacity-50" @onclick="OnClick"></div>

    <div class="bg-white shadow-lg rounded-lg p-4 sm:p-6 w-full max-w-xs sm:max-w-md mx-auto relative">
        <button class="absolute top-2 right-2 sm:top-4 sm:right-4 text-gray-500 hover:text-gray-700" @onclick="OnClick" aria-label="Close modal">
            &#x2715;
        </button>

        <div class="absolute top-2 left-4 sm:right-6 text-gray-400 text-xs sm:text-sm">
            @SelectedProduct.Barcode
        </div>

        <div class="flex flex-col mb-4">
            <div class="text-left pr-4 sm:flex sm:items-start">
                <div class="sm:w-1/2">
                    <h2 class="text-lg sm:text-xl font-semibold text-gray-800 mb-4 whitespace-nowrap">@SelectedProduct.Name</h2>

                    <div class="w-full flex justify-center mb-4 sm:hidden">
                        <img src="images/testafbeelding.png" alt="@SelectedProduct.Name" class="w-32 h-32 sm:w-48 sm:h-48 object-contain" />
                    </div>

                    <div class="mb-2">
                        <div class="flex justify-between items-center">
                            <p class="text-xs sm:text-sm text-gray-500"><strong>In Stock:</strong></p>
                            <p class="text-xs sm:text-sm text-green-600">@SelectedProduct.QuantityInStock</p>
                        </div>
                        <div class="flex justify-between items-center">
                            <p class="text-xs sm:text-sm text-gray-500"><strong>On Order:</strong></p>
                            <p class="text-xs sm:text-sm text-gray-500">@SelectedProduct.QuantityOnOrder</p>
                        </div>
                        <div class="flex justify-between items-center">
                            <p class="text-xs sm:text-sm text-gray-500"><strong>ClassRoom:</strong></p>
                            <p class="text-xs sm:text-sm text-gray-500">@SelectedProduct.ClassRoomCode</p>
                        </div>
                    </div>

                    <div class="bg-gray-200 p-3 sm:p-4 rounded-md">
                        <p class="text-xs sm:text-sm text-gray-600">@SelectedProduct.Description</p>
                    </div>
                </div>

                <div class="hidden sm:flex sm:w-1/2 justify-end">
                    <img src="images/testafbeelding.png" alt="@SelectedProduct.Name" class="w-32 h-32 sm:w-48 sm:h-48 object-contain" />
                </div>
            </div>
        </div>

        <div class="flex justify-center">
            <button class="bg-gray-200 text-gray-700 text-xs sm:text-sm px-3 sm:px-4 py-1 sm:py-2 rounded-full hover:bg-gray-300 cursor-not-allowed">
                Uitlenen
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public required ProductDto SelectedProduct { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
