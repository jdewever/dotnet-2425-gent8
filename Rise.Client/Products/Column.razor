@using Rise.Shared.Products

@if (Item == null)
{
    <th class="px-4 py-2 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">
        @Label
    </th>
}
else
{
    var property = string.IsNullOrEmpty(Name) ? null : typeof(ProductDto).GetProperty(Name);

    <td class="px-4 py-2 border-b border-gray-200 text-sm text-gray-700">
        @if (property != null)
        {
            @property?.GetValue(Item)?.ToString()
       }
        else
        {
            @ChildContent
        }
    </td>

    <div class="lg:hidden mb-2">
        <p class="text-sm text-gray-500">
            <strong>@Label:</strong> @if (property != null)
            {
                @property?.GetValue(Item)?.ToString()
            }
            else
            {
                @ChildContent
            }
        </p>
    </div>
}

@code {
    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public string Label { get; set; }

    [CascadingParameter]
    public ProductDto Item { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
