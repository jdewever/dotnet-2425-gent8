@using Rise.Shared.Products

@if (Item == null)
{
    <th class="px-4 py-2 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">
        @Label
    </th>
}
else
{
    var property = string.IsNullOrEmpty(Name) ? null : typeof(ProductDTO).GetProperty(Name);

    @if (Name != "Barcode")
    {
        <td class="px-4 py-2 border-b border-gray-200 text-sm text-gray-700 hidden lg:table-cell">
            @if (property != null)
            {
                @property?.GetValue(Item)?.ToString()
            }
            else
            {
                @ChildContent
            }
        </td>
    }
    else if (Name == "Barcode")
    {
        <td class="px-4 py-2 border-b border-gray-200 text-sm text-gray-700 lg:table-cell hidden">
            @property?.GetValue(Item)?.ToString()
        </td>
    }

    @if (Name != "Barcode")
    {
        <div class="lg:hidden mb-2 relative">
            <p class="text-sm text-gray-500 mb-2">
                <strong>@Label@(Label != "" ? ":" : "")</strong> @property?.GetValue(Item)?.ToString()
            </p>

            @if (ChildContent != null)
            {
                <div class="absolute bottom-4 right-4">
                    @ChildContent
                </div>
            }
        </div>
    }
    else if (Name == "Barcode")
    {
        <div class="lg:hidden mb-2">
            <p class="text-xs text-gray-400">
                @property?.GetValue(Item)?.ToString()
            </p>
        </div>
    }
}

@code {
    [Parameter] public string Name { get; set; }
    [Parameter] public string Label { get; set; }
    [CascadingParameter] public ProductDTO Item { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
