@using Rise.Shared.Products

@if (Item == null)
{
    <th class="px-10 py-2 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">@Label</th>
}
else
{
    var property = typeof(ProductDto).GetProperty(Name);
    <td class="px-10 py-2 border-b border-gray-200">@property.GetValue(Item).ToString()</td>
}

@code {
    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public string Label { get; set; }

    [CascadingParameter]
    public ProductDto Item { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
