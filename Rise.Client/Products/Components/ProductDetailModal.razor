@using Rise.Client.Products.Buttons;
@using Rise.Client.Components.Buttons;

<div class="fixed inset-0 flex items-center justify-center z-50">
    <div class="fixed inset-0 bg-black opacity-50" @onclick="OnCloseClick"></div>

    <div class="bg-white shadow-lg rounded-lg p-4 sm:p-6 relative mx-auto"
        style="min-width: 300px; min-height: 335px; max-width: 500px; max-height: 600px;">
        <button class="absolute top-2 right-2 sm:top-4 sm:right-4 text-gray-500 hover:text-gray-700"
            @onclick="OnCloseClick" aria-label="Close modal">
            &#x2715;
        </button>

        <div class="absolute top-2 left-4 sm:right-6 text-gray-400 text-xs sm:text-sm">
            @SelectedProduct.Barcode
        </div>

        <div class="flex flex-col mb-4">
            <div class="text-left pr-4 sm:flex sm:items-start">
                <div class="sm:w-1/2">
                    <h2 class="text-lg sm:text-xl font-semibold text-gray-800 mb-4 whitespace-nowrap">
                        @SelectedProduct.Name</h2>

                    <div class="w-full flex justify-center mb-4 sm:hidden">
                        <img src="@SelectedProduct.ImageUrl" alt="@SelectedProduct.Name"
                            class="w-32 h-32 sm:w-48 sm:h-48 object-contain" />
                    </div>

                    <div class="mb-2">
                        <div class="flex justify-between items-center">
                            <p class="text-xs sm:text-sm text-gray-500"><strong>In Stock:</strong></p>
                            <p
                                class="text-xs sm:text-sm @(SelectedProduct.QuantityInStock + SelectedProduct.QuantityOnOrder < SelectedProduct.LowStock ? "text-orange-400" : "text-green-600")">
                                @SelectedProduct.QuantityInStock
                            </p>
                        </div>
                        <div class="flex justify-between items-center">
                            <p class="text-xs sm:text-sm text-gray-500"><strong>On Order:</strong></p>
                            <p class="text-xs sm:text-sm text-gray-500">@SelectedProduct.QuantityOnOrder</p>
                        </div>
                        <div class="flex justify-between items-center">
                            <p class="text-xs sm:text-sm text-gray-500"><strong>ClassRoom:</strong></p>
                            <p class="text-xs sm:text-sm text-gray-500">@SelectedProduct.ClassRoomCode</p>
                        </div>
                    </div>

                    <div class="bg-gray-200 p-3 sm:p-4 rounded-md">
                        <p class="text-xs sm:text-sm text-gray-600">@SelectedProduct.Description</p>
                    </div>
                </div>

                <div class="hidden sm:flex sm:w-1/2 justify-end items-center">
                    <img src="@SelectedProduct.ImageUrl" alt="@SelectedProduct.Name"
                        class="w-32 h-32 sm:w-48 sm:h-48 object-contain" />
                </div>

            </div>
        </div>

        <div>
            <p class="text-xs sm:text-sm text-gray-600">
                @if (SelectedProduct.Categories != null && SelectedProduct.Categories.Any())
                {
                <ul>
                        @foreach (var category in SelectedProduct.Categories)
                        {
                        <li>
                            <div class="flex items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"
                                    class="size-4 mr-2">
                                    <path fill-rule="evenodd"
                                        d="M4.5 2A2.5 2.5 0 0 0 2 4.5v2.879a2.5 2.5 0 0 0 .732 1.767l4.5 4.5a2.5 2.5 0 0 0 3.536 0l2.878-2.878a2.5 2.5 0 0 0 0-3.536l-4.5-4.5A2.5 2.5 0 0 0 7.38 2H4.5ZM5 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
                                        clip-rule="evenodd" />
                                </svg>
                                <span>@category.Name</span>

                            </div>
                        </li>
                        }
                </ul>
                }
                else
                {
                <span>No categories</span>
                }
            </p>
        </div>

        <div class="absolute right-4 bottom-4 flex items-center space-x-2">
            <AuthorizeView Roles="Administrator">
                <SmallButton Text="Beheren" OnClick="ProductManagement" />
            </AuthorizeView>

            <SmallButton Text="@(Reserve ? "Reserveren" : "Uitscannen")" OnClick="@OnActionClick" />
        </div>
    </div>
</div>
