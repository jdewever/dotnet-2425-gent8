@using Rise.Shared.Products;

<div class="fixed inset-0 flex items-center justify-center z-50">
  <div class="fixed inset-0 bg-black opacity-50" @onclick="@HideModal"></div>

  <div class="bg-white shadow-lg rounded-lg p-4 sm:p-6 relative mx-auto mt-10"
        style="min-width: 300px; min-height: 235px; max-width: 600px; max-height: 300px;">
      <button class="absolute top-2 right-2 sm:top-4 sm:right-4 text-gray-500 hover:text-gray-700" @onclick="@HideModal" aria-label="Close modal">
          &#x2715;
      </button>
      <div class="flex overflow-x-scroll space-x-4 pb-4 pt-7 scrollbar-thin scrollbar-thumb-gray-900 scrollbar-track-gray-100 no-scrollbar">
          @for(int i = 0; i < Product.QuantityInStock; i++)
          {
              <div class="flex-shrink-0 border border-gray-300 p-2">
                  <img src="@Product.ImageUrl" alt="Item Image" class="h-32 w-32 object-contain mb-2 cursor-pointer" @onclick="NavigateToAgenda">
              </div>
          }
      </div>
  </div>
</div>
