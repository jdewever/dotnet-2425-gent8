<div class="flex items-center justify-between w-full">
    <!-- Left side elements -->
    <div class="flex items-center space-x-2">
        <!-- Toggle Buttons -->
        <label class="relative inline-flex items-center cursor-pointer">
            <div class="w-16 h-8 bg-gray-200 rounded-full peer flex items-center justify-between px-2">
                <svg @onclick="OnShowColumnTable" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 transition-all duration-300 hover:scale-110">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125Z"/>
                </svg>
                <svg @onclick="OnShowRegularTable" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 transition-all duration-300 hover:scale-110">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
                </svg>
            </div>
        </label>

        <!-- Filter Icon -->
        <div @onclick="ShowModal" class="cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 transition-all duration-300 hover:scale-110">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z"/>
            </svg>
        </div>

        <!-- Active Filters -->
        <div class="flex flex-row flex-wrap gap-1">
            @{
                var categoryIds = GetFilters().CategoryIds;
            }
            @if (categoryIds != null)
            {
                foreach (var categoryId in categoryIds)
                {
                    <div class="border rounded-lg flex flex-row py-1 px-2">
                        <p class="me-1">@GetCategoryById(categoryId)</p>
                        <button @onclick='() => RemoveFilter("Category", categoryId)'>x</button>
                    </div>
                }
            }
            @if (Location != null)
            {
                <div class="border rounded-lg flex flex-row py-1 px-2">
                    <p class="me-1">@Location</p>
                    <button @onclick='() => RemoveFilter("Location", null)'>x</button>
                </div>
            }
            @if (MaxInStock != null || MinInStock != null)
            {
                <div class="border rounded-lg flex flex-row py-1 px-2">
                    <p class="me-1">Aantal in stock: @GetFilterRangeString(MinInStock,MaxInStock)</p>
                    <button @onclick='() => RemoveFilter("InStock", null)'>x</button>
                </div>
            }
            @if (MaxOnOrder != null || MinOnOrder != null)
            {
                <div class="border rounded-lg flex flex-row py-1 px-2">
                    <p class="me-1">Aantal besteld: @GetFilterRangeString(MinOnOrder, MaxOnOrder)</p>
                    <button @onclick='() => RemoveFilter("OnOrder", null)'>x</button>
                </div>
            }
        </div>
    </div>

</div>