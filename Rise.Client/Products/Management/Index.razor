@page "/products/management"
@attribute [Authorize(Roles = "Administrator")]
@using Rise.Client.Components.Buttons
@using Rise.Client.Manage.Components
@using Rise.Client.Products.Management.Components


<PageTitle>Product Management</PageTitle>

<h2 class="text-3xl font-bold text-center text-gray-900 mb-8">Product beheren</h2>

<div class="flex items-center justify-center min-h-screen">
    <div class="max-w-3xl">
        @if (SelectedProduct is null)
        {
            <FormLoader />
        }
        else
        {
            <EditForm Model="@SelectedProduct" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />

                <div class="grid md:grid-cols-1 md:gap-6">

                    @* Changing fields Name, ClassRoomCode, Descsription *@
                    <div class="grid md:grid-cols-1 md:gap-6">
                        <div>
                            <label for="name" class="label-form">Naam</label>
                            <InputText id="name" @bind-Value="SelectedProduct.Name" class="input-text-form"
                                placeholder="@InitProduct.Name" />
                            <ValidationMessage For="@(() => SelectedProduct.Name)" class="validation-message" />

                            <label for="location" class="label-form mt-5">Lokaal</label>
                            <InputText id="location" @bind-Value="SelectedProduct.ClassRoomCode" class="input-text-form"
                                placeholder="@InitProduct.ClassRoomCode" />
                            <ValidationMessage For="@(() => SelectedProduct.ClassRoomCode)" class="validation-message" />

                            <label for="description" class="label-form mt-5">Omschrijving</label>
                            <InputTextArea id="description" @bind-Value="SelectedProduct.Description" rows="4"
                                class="input-text-area-form" placeholder="@InitProduct.Description" />
                            <ValidationMessage For="@(() => SelectedProduct.Description)" class="validation-message" />
                        </div>
                    </div>

                    @* Showing Barcode and Image *@
                    <div class="grid md:grid-cols-2 md:gap-6">
                        <div>
                            <label for="barcodeImage" class="label-form">Barcode</label>
                            <img id="barcodeImage"
                                 src="@($"{NavigationManager.BaseUri}api/barcode/{InitProduct.Barcode}/image")" alt="Barcode"
                                 class="w-full h-auto" />
                            <a href="@($"{NavigationManager.BaseUri}api/barcode/{InitProduct.Barcode}/image")" download="barcode-@InitProduct.Barcode">
                                <button type="button"
                                        class="bg-gray-200 text-gray-700 text-xs px-2 py-1 rounded-full hover:bg-gray-300 mt-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                                        <path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z" />
                                        <path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z" />
                                    </svg>
                                </button>
                            </a>
                        </div>

                        <div>
                            <label for="image" class="label-form">Foto</label>
                            <img
                                src="@(SelectedProduct.ImageUrl)"
                                alt="Product" class="w-full h-auto mb-2" />
                            <InputFile id="image" accept="image/*" OnChange="HandleFileSelected" class="input-text-form cursor-pointer"/>
                        </div>
                    </div>
                </div>

                <hr class="my-6 h-0.5 border-t-0 bg-neutral-200" />

                @* Changing Amounts for QuantityInStock, QuantityOnOrder, LowStock *@
                <div class="grid md:grid-cols-3 md:gap-6">
                    <div>
                        <label for="QuantityInStock" class="label-form">Aantal toevoegen in stock</label>
                        <InputNumber id="QuantityInStock" @bind-Value="SelectedProduct.QuantityInStock"
                            class="input-text-form" placeholder="@InitProduct.QuantityInStock" />
                        <ValidationMessage For="@(() => SelectedProduct.QuantityInStock)" class="validation-message" />
                    </div>
                    <div>
                        <label for="QuantityOnOrder" class="label-form">Aantal nog op bestelling</label>
                        <InputNumber id="QuantityOnOrder" @bind-Value="SelectedProduct.QuantityOnOrder"
                            class="input-text-form" placeholder="@InitProduct.QuantityOnOrder" />
                        <ValidationMessage For="@(() => SelectedProduct.QuantityOnOrder)" class="validation-message" />
                    </div>
                    <div>
                        <label for="LowStock" class="label-form">Min gewenste voorraad</label>
                        <InputNumber id="LowStock" @bind-Value="SelectedProduct.LowStock" class="input-text-form"
                            placeholder="@InitProduct.LowStock" />
                        <ValidationMessage For="@(() => SelectedProduct.LowStock)" class="validation-message" />
                    </div>
                </div>

                <div class="grid md:grid-cols-3 md:gap-6 mt-5">
                    @* Changing fields IsReservable, IsHidden *@
                    <div class="flex flex-col align-middle">
                        <label class="label-form">Productopties</label>
                        <div class="flex flex-row space-x-4">
                            <InputCheckbox id="isReservable" @bind-Value="SelectedProduct.IsReservable"
                                class="input-checkbox-form mt-0" />
                            <label for="isReservable" class="peer label-form">Product is reserveerbaar</label>
                        </div>
                        <div class="flex flex-row space-x-4">
                            <InputCheckbox id="isHidden" @bind-Value="SelectedProduct.IsHidden"
                                class="input-checkbox-form mt-0" />
                            <label for="isHidden" class="peer label-form">Product verbergen</label>
                        </div>
                    </div>

                    @* Changing field Categories *@
                    <div class="col-span-2">
                        <div class="flex items-center justify-between">
                            <label class="label-form">Categorieën</label>
                            <SmallButton Type="button" OnClick="ShowAddModal" Text="Toevoegen"
                                ExtraCss="bg-green-200 text-green-700 hover:bg-green-300" />
                        </div>
                        <div>
                            <section class="flex items-center">
                                <InputSelect @bind-Value="SelectedProduct.CategoryOneId" class="input-text-form my-2 mx-4">
                                    <option value="-1">Geen categorie</option>
                                    @foreach (var category in CategoryOptions)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </InputSelect>
                                <AddCategoryButton Type="button" OnClick="AddCategory" Text="+" />
                            </section>
                            @if (SelectedProduct.CategoryTwoId != -1)
                            {
                                <section class="flex items-center">
                                    <InputSelect @bind-Value="SelectedProduct.CategoryTwoId" class="input-text-form my-2 mx-4">
                                        <option value="-1">Geen categorie</option>
                                        @foreach (var category in CategoryOptions.Where(c => c.Id !=
                                SelectedProduct.CategoryOneId && c.Id != SelectedProduct.CategoryThreeId))
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    </InputSelect>
                                </section>
                            }
                            @if (SelectedProduct.CategoryThreeId != -1)
                            {
                                <section class="flex items-center">
                                    <InputSelect @bind-Value="SelectedProduct.CategoryThreeId"
                                        class="input-text-form my-2 mx-4">
                                        <option value="-1">Geen categorie</option>
                                        @foreach (var category in CategoryOptions.Where(c => c.Id !=
                                SelectedProduct.CategoryOneId && c.Id != SelectedProduct.CategoryTwoId))
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    </InputSelect>
                                </section>
                            }
                        </div>
                    </div>
                </div>

                <hr class="my-6 h-0.5 border-t-0 bg-neutral-200" />

                @* Buttons *@
                <div class="flex justify-between mb-5 md:mx-20">
                    <BigButton Type="button" OnClick="HandleDelete" Text="Verwijderen" />
                    <BigButton Type="submit" Text="Wijzigen" />
                </div>
            </EditForm>
        }
    </div>
</div>

@if (selectedCategory != null)
{
    <EditCategoryModal Item="selectedCategory" OnClose="HideEditModal" OnConfirm="OnSave" />
}
