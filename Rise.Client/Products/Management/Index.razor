@page "/products/management/"
@attribute [Authorize(Roles = "Administrator")]
@using Rise.Client.Components.Buttons


<PageTitle>Product Management</PageTitle>

<body class="flex items-center justify-center min-h-screen">
    <div class="max-w-3xl">
        <EditForm Model="@newProduct" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />

            <div class="grid md:grid-cols-1 md:gap-6">
                <div class="grid md:grid-cols-1 md:gap-6">
                    <div>
                        <label for="name" class="label-form">Naam</label>
                        <InputText @bind-Value="newProduct.Name" class="input-text-form" placeholder="naam" />
                        <ValidationMessage For="@(() => newProduct.Name)" class="validation-message" />

                        <label for="location" class="label-form mt-5">Lokaal</label>
                        <InputText @bind-Value="newProduct.ClassRoomCode" class="input-text-form"
                            placeholder="lokaal" />
                        <ValidationMessage For="@(() => newProduct.ClassRoomCode)" class="validation-message" />

                        <label for="description" class="label-form mt-5">Omschrijving</label>
                        <InputTextArea @bind-Value="newProduct.Description" rows="4" class="input-text-area-form"
                            placeholder="omschrijving ..." />
                        <ValidationMessage For="@(() => newProduct.Description)" class="validation-message" />
                    </div>
                </div>

                <div class="grid md:grid-cols-2 md:gap-6">
                    <div>
                        <div>
                            <label for="barcodeImage" class="label-form">Barcode</label>
                            @if (!string.IsNullOrEmpty(newProduct.Barcode))
                            {
                                <img src="@($"{NavigationManager.BaseUri}api/barcodes/{newProduct.Barcode}/image")"
                                    alt="Barcode" class="w-full h-auto" />
                            }
                            else
                            {
                                <p class="text-sm text-gray-500">Geen barcode beschikbaar</p>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="label-form" for="user_avatar">Foto</label>
                        <InputFile OnChange="HandleFileSelected" class="input-text-form cursor-pointer" />
                    </div>
                </div>
            </div>

            <hr class="my-12 h-0.5 border-t-0 bg-neutral-200" />

            <div class="grid md:grid-cols-3 md:gap-6">
                <div>
                    <label for="lowStock" class="label-form">Aantal toevoegen
                        in stock</label>
                    <InputNumber @bind-Value="newProduct.QuantityInStock" class="input-text-form"
                        placeholder="aantal" />
                    <ValidationMessage For="@(() => newProduct.QuantityInStock)" class="validation-message" />
                </div>
                <div>
                    <label for="lowStock" class="label-form">Aantal nog op
                        bestelling</label>
                    <InputNumber @bind-Value="newProduct.QuantityOnOrder" class="input-text-form"
                        placeholder="aantal" />
                    <ValidationMessage For="@(() => newProduct.QuantityOnOrder)" class="validation-message" />
                </div>
                <div>
                    <label for="lowStock" class="label-form">Min gewenste
                        voorraad</label>
                    <InputNumber @bind-Value="newProduct.LowStock" class="input-text-form" placeholder="aantal" />
                    <ValidationMessage For="@(() => newProduct.LowStock)" class="validation-message" />
                </div>
            </div>

            <div class="grid md:grid-cols-3 md:gap-6 mt-5">
                <div>
                    <div class="flex row-span-2">
                        <InputCheckbox @bind-Value="newProduct.IsReservable" class="input-checkbox-form" />
                        <label for="checkbox-3" class="label-form">Product is reserveerbaar</label>
                    </div>
                    <div>
                        <InputCheckbox @bind-Value="newProduct.IsHidden" class="input-checkbox-form" />
                        <label for="checkbox-3" class="label-form">Product verbergen</label>
                    </div>
                </div>

                <div>
                    <label for="categories" class="label-form">Categorieën</label>
                    <div class="flex items-center justify-between">
                        <select @bind="selectedCategory" class="input-text-form">
                            <option value="">Selecteer categorie</option>
                            @foreach (var category in CategoryOptions.Where(c =>
                            !newProduct.CategoryIds.Contains(c.Id)))
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                        <AddButton OnClick="AddCategory" />
                    </div>
                    <ValidationMessage For="@(() => newProduct.CategoryIds)" class="validation-message" />
                    <label for="newCategory" class="label-form mt-5">Nieuwe
                        categorie toevoegen</label>
                    <div class="flex items-center">
                        <InputText @bind-Value="newCategoryName" class="input-text-form"
                            placeholder="Voer een nieuwe categorie in" />
                        <AddButton OnClick="AddNewCategory" />
                    </div>
                    @if (showAddCategoryError)
                    {
                        <p class="text-xs text-red-500 mt-1">Naam is verplicht.</p>
                    }
                </div>

                <div class="flex-wrap gap-2 mt-4">
                    @foreach (var selectedCategory in newProduct.CategoryIds)
                    {
                        <div class="flex items-center bg-gray-200 px-3 py-1 rounded-full justify-between w-full mb-2">
                            <span>@CategoryOptions.FirstOrDefault(c => c.Id == selectedCategory)?.Name</span>
                            <RemoveButton OnClick="() => RemoveCategory(selectedCategory)" />
                        </div>
                    }
                </div>
            </div>
            <hr class="my-12 h-0.5 border-t-0 bg-neutral-200" />

            <div class="flex justify-between mb-5 mx-20">
                <BigButton OnClick="HandleDelete" Text="Verwijderen" />
                <BigButton Type="submit" Text="Wijzigen" />
            </div>
        </EditForm>
    </div>
</body>
