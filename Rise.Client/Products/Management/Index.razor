@page "/products/management/"
@attribute [Authorize(Roles = "Administrator")]
@using Rise.Client.Components.Buttons
@using Rise.Shared.Products


<PageTitle>Product Management</PageTitle>

<body class="flex items-center justify-center min-h-screen">
    <div class="max-w-3xl">
        @if (SelectedProduct is null)
        {
            <p class="text-center text-2xl">Selecteer een product om te bewerken.</p>
        }
        else
        {
            <EditForm Model="@newProduct" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />

                <div class="grid md:grid-cols-1 md:gap-6">

                    @* Changing fields Name, ClassRoomCode, Descsription *@
                    <div class="grid md:grid-cols-1 md:gap-6">
                        <div>
                            <label for="name" class="label-form">Naam</label>
                            <InputText id="name" @bind-Value="SelectedProduct.Name" class="input-text-form"
                                placeholder="@newProduct.Name" />
                            <ValidationMessage For="@(() => newProduct.Name)" class="validation-message" />

                            <label for="location" class="label-form mt-5">Lokaal</label>
                            <InputText id="location" @bind-Value="SelectedProduct.ClassRoomCode" class="input-text-form"
                                placeholder="@newProduct.ClassRoomCode" />
                            <ValidationMessage For="@(() => newProduct.ClassRoomCode)" class="validation-message" />

                            <label for="description" class="label-form mt-5">Omschrijving</label>
                            <InputTextArea id="description" @bind-Value="SelectedProduct.Description" rows="4"
                                class="input-text-area-form" placeholder="@newProduct.Description" />
                            <ValidationMessage For="@(() => newProduct.Description)" class="validation-message" />
                        </div>
                    </div>

                    @* Showing Barcode and Image *@
                    <div class="grid md:grid-cols-2 md:gap-6">
                        <div>
                            <label for="barcodeImage" class="label-form">Barcode</label>
                            <img id="barcodeImage"
                                src="@($"{NavigationManager.BaseUri}api/barcodes/{SelectedProduct.Barcode}/image")"
                                alt="Barcode" class="w-full h-auto" />
                        </div>
                        <div>
                            <label for="product_avatar" class="label-form">Foto</label>
                            <InputFile id="product_avatar" OnChange="HandleFileSelected"
                                class="input-text-form cursor-pointer" />
                        </div>
                    </div>
                </div>

                <hr class="my-12 h-0.5 border-t-0 bg-neutral-200" />

                @* Changing Amounts for QuantityInStock, QuantityOnOrder, LowStock *@
                <div class="grid md:grid-cols-3 md:gap-6">
                    <div>
                        <label for="QuantityInStock" class="label-form">Aantal toevoegen in stock</label>
                        <InputNumber id="QuantityInStock" @bind-Value="SelectedProduct.QuantityInStock"
                            class="input-text-form" placeholder="@newProduct.QuantityInStock" />
                        <ValidationMessage For="@(() => newProduct.QuantityInStock)" class="validation-message" />
                    </div>
                    <div>
                        <label for="QuantityOnOrder" class="label-form">Aantal nog op bestelling</label>
                        <InputNumber id="QuantityOnOrder" @bind-Value="SelectedProduct.QuantityOnOrder"
                            class="input-text-form" placeholder="@newProduct.QuantityOnOrder" />
                        <ValidationMessage For="@(() => newProduct.QuantityOnOrder)" class="validation-message" />
                    </div>
                    <div>
                        <label for="LowStock" class="label-form">Min gewenste voorraad</label>
                        <InputNumber id="LowStock" @bind-Value="SelectedProduct.LowStock" class="input-text-form"
                            placeholder="@newProduct.LowStock" />
                        <ValidationMessage For="@(() => newProduct.LowStock)" class="validation-message" />
                    </div>
                </div>

                <div class="grid md:grid-cols-3 md:gap-6 mt-5">
                    @* Changing fields IsReservable, IsHidden *@
                    <div>
                        <div class="flex row-span-2">
                            <InputCheckbox @bind-Value="SelectedProduct.IsReservable" class="input-checkbox-form" />
                            <label for="checkbox-3" class="label-form">Product is reserveerbaar</label>
                        </div>
                        <div>
                            <InputCheckbox @bind-Value="SelectedProduct.IsHidden" class="input-checkbox-form" />
                            <label for="checkbox-3" class="label-form">Product verbergen</label>
                        </div>
                    </div>

                    @* Changing field Categories *@
                    <div>
                        <label for="categories" class="label-form">Categorieën</label>
                        <div class="flex items-center justify-between">
                            <select @bind="selectedCategory" class="input-text-form">
                                <option value="">Selecteer categorie</option>
                                @foreach (var category in CategoryOptions)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <AddButton OnClick="AddCategory" />
                        </div>
                        <ValidationMessage For="@(() => newProduct.CategoryIds)" class="validation-message" />
                    </div>

                    <div class="flex-wrap gap-2 mt-4">
                        @foreach (var selectedCategory in SelectedProduct.Categories?.Select(c => c.Id) ??
                       Enumerable.Empty<int>())
                        {
                            <div class="flex items-center bg-gray-200 px-3 py-1 rounded-full justify-between w-full mb-2">
                                <span>@CategoryOptions.FirstOrDefault(c => c.Id == selectedCategory)?.Name</span>
                                <RemoveButton OnClick="() => RemoveCategory(selectedCategory)" />
                            </div>
                        }
                    </div>
                </div>

                <hr class="my-12 h-0.5 border-t-0 bg-neutral-200" />

                @* Buttons *@
                <div class="flex justify-between mb-5 mx-20">
                    <BigButton OnClick="HandleDelete" Text="Verwijderen" />
                    <BigButton Type="submit" Text="Wijzigen" />
                </div>
            </EditForm>
        }
    </div>
</body>
