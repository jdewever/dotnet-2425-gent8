@page "/products/management"
@attribute [Authorize(Roles = "Administrator")]
@using Rise.Client.Products.Buttons
@using Rise.Client.Products.Management.Components


<PageTitle>Product Management</PageTitle>

<div class="z-10 flex justify-center w-full">
    @foreach (var button in new[] { "Wijzigen", "Verbergen", "Verwijderen" })
    {
        <button class="@GetButtonClass(button)" @onclick='() => SelectButton(button)'>@button</button>
    }
</div>
<main>
    @* @switch (selectedButton)
    {
        case "Wijzigen":
            <EditProduct />
            break;
        case "Verbergen":
            <HideProduct />
            break;
        case "Verwijderen":
            <DeleteProduct />
            break;
    } *@
</main>
