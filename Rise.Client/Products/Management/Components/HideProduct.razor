@attribute [Authorize]

<PageTitle>Hide Product</PageTitle>


<main class="flex justify-center p-4 w-full">
    <div class="flex flex-col items-center xl:w-1/2">
        <div>
            <label for="name" class="block mb-2 text-sm font-medium text-gray-900">@SelectedProduct?.Barcode</label>
        </div>
        <div class="bg-gray-100 rounded-lg p-8 mb-4" style="height: 50vh;">
            <img src="images/testafbeelding.png" alt="Product Image" class="h-full w-auto object-contain" />
        </div>
        <button @onclick="@(() => HideProductHandler())"
            class="mt-4 px-6 py-2 bg-gray-300 text-gray-600 rounded-lg">Verberg</button>
    </div>
</main>