@using Rise.Shared.Products
@using Microsoft.AspNetCore.Components
@inherits ProductModal

<div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-4">
    @foreach (var product in Products)
    {
        <ProductView Product="product" ImageUrl="/images/testafbeelding.png" OnClick="@(() => ShowModal(product))"/>
    }
    @if (isModalVisible && selectedProduct != null)
    {
        <ProductDetailModal SelectedProduct="@selectedProduct" OnClick="CloseModal" />
    }
</div>

@code {
  
    [Parameter] public required IEnumerable<ProductDTO> Products { get; set; }
    
}