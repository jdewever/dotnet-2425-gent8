@using Rise.Client.Products.Buttons;
@using Rise.Client.Components.Buttons;

<div class="fixed inset-0 flex items-center justify-center z-50">
    <div class="fixed inset-0 bg-black opacity-50" @onclick="OnCloseClick"></div>

    <div class="bg-white shadow-lg rounded-lg p-4 sm:p-6 relative mx-auto min-w-[300px] max-w-[500px] min-h-[100px]">
        <button class="absolute top-2 right-2 sm:top-4 sm:right-4 text-gray-500 hover:text-gray-700" @onclick="OnCloseClick" aria-label="Close modal">
            &#x2715;
        </button>

        <div class="flex flex-col mb-4">
            <div class="text-left pr-4">
                <h2 class="text-lg sm:text-xl font-semibold text-gray-800 mb-4 whitespace-nowrap">Verwijder @ItemType: @ItemName?</h2>
                <p>
                    Weet u zeker dat u <span class="font-bold">@ItemName</span> wilt verwijderen? Dit kan niet ongedaan gemaakt worden. Ook gerelateerde data wordt verwijderd.
                </p>

            </div>
        </div>

        <div class="flex justify-end space-x-2">
            <SmallButton Text="Annuleren" OnClick="OnCloseClick" />
            <SmallButton Text="Verwijderen" OnClick="OnConfirmClick" ExtraCss="bg-red-400 hover:bg-red-600" />
        </div>
    </div>
</div>
