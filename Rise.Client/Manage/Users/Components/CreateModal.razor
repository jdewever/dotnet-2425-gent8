@using Rise.Shared.User;
@using Rise.Client.Manage.Components;
@inherits EditModal<UserCreationDTO>
@using Microsoft.AspNetCore.Components.Forms;
@using Rise.Client.Components.Buttons;

<div class="fixed inset-0 flex items-center justify-center z-50">
    <div class="fixed inset-0 bg-black opacity-50" @onclick="OnCloseClick"></div>

    <div class="bg-white shadow-lg rounded-lg p-4 sm:p-6 relative mx-auto min-w-[300px] max-w-[500px] min-h-[100px]">
        <button class="absolute top-2 right-2 sm:top-4 sm:right-4 text-gray-500 hover:text-gray-700"
            @onclick="OnCloseClick" aria-label="Close modal">
            &#x2715;
        </button>

        <div class="flex flex-col my-4">
            <EditForm Model="@Item" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />

                <div class="grid md:grid-cols-1 md:gap-6">
                    <div class="grid md:grid-cols-1 md:gap-6">
                        <div>
                            <label for="name" class="block mb-2 text-sm font-medium text-gray-900">Voornaam</label>
                            <InputText @bind-Value="Item.FirstName" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Voornaam" />
                            <ValidationMessage For="@(() => Item.FirstName)" class="text-xs text-red-500 mt-0 p-0" />

                            <label for="name" class="block mb-2 text-sm font-medium text-gray-900">Achternaam</label>
                            <InputText @bind-Value="Item.LastName" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Achternaam" />
                            <ValidationMessage For="@(() => Item.LastName)" class="text-xs text-red-500 mt-0 p-0" />

                            <label class="block mb-2 text-sm font-medium text-gray-900" for="email">Emailadres</label>
                            <InputText @bind-Value="Item.Email" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Emailadres" />
                            <ValidationMessage For="@(() => Item.Email)" class="text-xs text-red-500 mt-0 p-0" />

                            <label class="block mb-2 text-sm font-medium text-gray-900" for="role">Rol</label>
                            <InputSelect @bind-Value="Item.Role" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                                <option value="Administrator">Administrator</option>
                                <option value="Inventory Manager">Voorraadbeheerder</option>
                                <option value="User">Gebruiker</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => Item.Role)" class="text-xs text-red-500 mt-0 p-0" />

                            <label class="block mb-2 text-sm font-medium text-gray-900" for="password">Wachtwoord</label>
                            <InputText @bind-Value="Item.Password" class="bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Wachtwoord" />
                            <ValidationMessage For="@(() => Item.Password)" class="text-xs text-red-500 mt-0 p-0" />
                        </div>
                    </div>
                </div>

                <div class="pt-6 flex justify-center space-x-4">
                    <button type="submit" class="bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-md">Opslaan</button>
                    <BigButton Text="Annuleren" OnClick="OnCloseClick" ExtraCss="font-normal" />
                </div>
            </EditForm>
        </div>
    </div>
</div>    using Rise.Shared.User;

#line default
#line hidden
#nullable disable
