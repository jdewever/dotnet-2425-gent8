@using Rise.Client.Components.Buttons
<div class="border border-gray-300 rounded-3xl w-fit p-5 flex flex-row mx-auto">
    <img class="rounded-full me-3" width="150px" src="@User.Picture" alt="Profile Picture"/>
    <div class="flex flex-col justify-between p-2">
        <p>@User.FullName</p>
        <p>@User.Email</p>
        <SmallButton Text="Wachtwoord veranderen" OnClick="ChangePassword"/>
    </div>
</div>