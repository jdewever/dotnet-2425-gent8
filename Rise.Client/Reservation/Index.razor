@page "/agenda"
@inject IJSRuntime JSRuntime;
@using Blazored.Toast.Services;

@inject NavigationManager NavigationManager;
@inject IToastService ToastService;

<div class="p-8">
    <div class="flex justify-center items-center space-x-8 mb-8">
        <span class="bg-gray-500 rounded-full px-4 py-2">Niet Beschikbaar</span>
        <span class="bg-gray-200 rounded-full px-4 py-2">Gereserveerd</span>
    </div>
    
    <div class="w-full max-w-lg mx-auto">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-semibold">@currentMonth.ToString("MMMM yyyy")</h2>
            <div class="space-x-2">
                @if (!IsPreviousMonthDisabled)
                {
                    <button class="px-2 py-1 bg-gray-200 rounded" @onclick="PreviousMonth">&lt;</button>
                }
                <button class="px-2 py-1 bg-gray-200 rounded" @onclick="NextMonth">&gt;</button>
            </div>
        </div>

        <div class="grid grid-cols-7 text-center select-none" @onmousedown="StartSelection" @onmouseup="EndSelection" @onmousemove="(e) => UpdateSelection(e)">
            <span class="font-semibold">Ma</span>
            <span class="font-semibold">Di</span>
            <span class="font-semibold">Wo</span>
            <span class="font-semibold">Do</span>
            <span class="font-semibold">Vr</span>
            <span class="font-semibold">Za</span>
            <span class="font-semibold">Zo</span>
            
            @for (int day = 1; day <= DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month); day++)
            {
                var isPastDate = currentMonth.Year == DateTime.Now.Year && currentMonth.Month == DateTime.Now.Month && day < DateTime.Now.Day;
                var isInRange = firstSelectedDay.HasValue && lastSelectedDay.HasValue && day >= Math.Min(firstSelectedDay.Value, lastSelectedDay.Value) && day <= Math.Max(firstSelectedDay.Value, lastSelectedDay.Value);
                <div class="relative p-2 border rounded h-20 day-cell @(isPastDate ? "bg-gray-100" : "")" data-day="@day" @onmouseover="() => SelectDay(day)" style="@(isPastDate ? "pointer-events: none;" : "")">
                    <div class="absolute left-0 right-0 mx-auto bg-green-500" style="height: 10px; top: 15px;" hidden="@(isInRange ? false : true)"></div>
                    <span class="absolute top-1 left-1 text-xs select-none pointer-events-none">@day</span>
                </div>
            }
        </div>
        <div class="flex justify-center items-center">
            <button class="mt-4 w-1/3 px-4 py-2 bg-gray-300 rounded" @onclick="ShowModal" disabled="@(!selectedDays.Any())">Reserveer</button>
        </div>
        
    </div>
</div>


@if (isModalVisible)
{
    <div class="fixed inset-0 flex items-center justify-center bg-gray-800 bg-opacity-75">
        <div class="bg-white p-8 rounded-lg shadow-lg w-1/3">
            <h2 class="text-xl font-semibold mb-4">Reserveer</h2>
            <label class="block mb-2">Productnaam : ...</label>
            <label class="block mb-2">Geselecteerde Datums : @GetSelectedDateRange()</label>
            <label class="block mb-2">Startuur</label>
            <input type="text" class="w-full p-2 border rounded mb-4"/>
            <label class="block mb-2">Einduur</label>
            <input type="text" class="w-full p-2 border rounded mb-4"/>
            <div class="flex justify-end space-x-4">
                <button class="px-4 py-2 bg-gray-300 rounded" @onclick="HideModal">Annuleren</button>
                <button class="px-4 py-2 bg-blue-500 text-white rounded" @onclick="Reserve">Reserveer</button>
            </div>
        </div>
    </div>
}

@code {
    private DateTime currentMonth = DateTime.Now;
    private bool isSelecting = false;
    private List<int> selectedDays = new List<int>();
    private int? firstSelectedDay = null;
    private int? lastSelectedDay = null;
    private bool isModalVisible = false;
    

    private bool IsPreviousMonthDisabled => currentMonth.Year < DateTime.Now.Year || (currentMonth.Year == DateTime.Now.Year && currentMonth.Month <= DateTime.Now.Month);

    private void PreviousMonth()
    {
        if (!IsPreviousMonthDisabled)
        {
            currentMonth = currentMonth.AddMonths(-1);
            ClearSelection();
        }
    }

    private void NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        ClearSelection();
    }

    private void StartSelection()
    {
        isSelecting = true;
        ClearSelection();
    }

    private void EndSelection()
    {
        isSelecting = false;
    }

    private void ClearSelection()
    {
        selectedDays.Clear();
        firstSelectedDay = null;
        lastSelectedDay = null;
    }
    private void ShowModal()
    {
        isModalVisible = true;
    }

    private void HideModal()
    {
        isModalVisible = false;
    }

    private void Reserve()
    {
        ToastService.ShowSuccess("Reservatie succesvol aangemaakt");
        NavigationManager.NavigateTo("/products");
        HideModal();
    }
    private string GetSelectedDateRange()
    {
        if (firstSelectedDay.HasValue && lastSelectedDay.HasValue)
        {
            var startDate = new DateTime(currentMonth.Year, currentMonth.Month, firstSelectedDay.Value);
            var endDate = new DateTime(currentMonth.Year, currentMonth.Month, lastSelectedDay.Value);
            return $"{startDate:MMMM d} - {endDate:MMMM d}";
        }
        return string.Empty;
    }
    private void UpdateSelection(MouseEventArgs e)
    {
        // JavaScript Script
    }

    private void SelectDay(int day)
    {
        var isPastDate = currentMonth.Year == DateTime.Now.Year && currentMonth.Month == DateTime.Now.Month && day < DateTime.Now.Day;
        if (isSelecting && !isPastDate)
        {
            if (!firstSelectedDay.HasValue)
            {
                firstSelectedDay = day;
            }
            lastSelectedDay = day;

            selectedDays.Clear();
            for (int i = Math.Min(firstSelectedDay.Value, lastSelectedDay.Value); i <= Math.Max(firstSelectedDay.Value, lastSelectedDay.Value); i++)
            {
                selectedDays.Add(i);
            }

            StateHasChanged(); 
        }
    }

    [JSInvokable]
    public void UpdateSelection(int day)
    {
        SelectDay(day);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("dragSelection.startSelection", DotNetObjectReference.Create(this));
        }
    }
}

<script>
    window.dragSelection = {
        startSelection: function (dotNetHelper) {
            document.addEventListener('mousedown', function (event) {
                dotNetHelper.invokeMethodAsync('StartSelection');
            });

            document.addEventListener('mouseup', function (event) {
                dotNetHelper.invokeMethodAsync('EndSelection');
            });

            document.addEventListener('mousemove', function (event) {
                if (event.buttons === 1) { 
                    let element = document.elementFromPoint(event.clientX, event.clientY);
                    if (element && !element.classList.contains('day-cell')) {
                        element = element.closest('.day-cell');
                    }
                    if (element && element.classList.contains('day-cell')) {
                        const day = element.getAttribute('data-day');
                        dotNetHelper.invokeMethodAsync('UpdateSelection', parseInt(day));
                    }
                }
            });
        }
    };
</script>