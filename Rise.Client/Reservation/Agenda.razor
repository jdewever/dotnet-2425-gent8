@inject IJSRuntime JSRuntime
@using Rise.Shared.Products
@using Blazored.Toast.Services
@inject IProductService ProductService
@inject IBookingService BookingService
@inject BarcodeService BarcodeService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<div class="flex">
    <div class="p-5 w-1/2">
        <div class="flex justify-between mb-4">
            <h2 class="text-xl font-semibold mx-4">@currentDate.ToString("d MMMM yyyy")</h2>
            <div class="text-xl">
                @if(currentDate.Date > DateTime.Now.Date)
                {
                    <button class="px-2 py-1" @onclick="PreviousDate">&lt;</button>
                }
                <button class="px-2 py-1" @onclick="NextDate">&gt;</button>
            </div>
        </div>
        <div class="h-[calc(100vh-15rem)] overflow-y-auto mt-5 mx-10 no-scrollbar">
            <div class="grid grid-cols-1">
                @for (int hour = 0; hour < 24; hour++)
                {
                    int capturedHour = hour;
                    <div class="h-24 flex items-top cursor-pointer hour-cell" data-hour="@capturedHour" @onclick="() => SelectHour(capturedHour)">
                        <span class="font-bold w-16 select-none">@capturedHour:00</span>
                        <div class="flex-grow border-t border-gray-300 ml-4 @GetHourClass(capturedHour)  @GetHourSelectableClass(capturedHour)"></div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="p-5 w-1/2">
        <h2 class="text-xl text-center font-semibold mx-4">@currentDate.ToString("MMMM yyyy")</h2>
        <div class="h-1/3 overflow-y-auto mt-5 mx-10 no-scrollbar" id="calendarGrid">
            <div class="grid grid-cols-7 text-center">
                <span class="font-semibold">Ma</span>
                <span class="font-semibold">Di</span>
                <span class="font-semibold">Wo</span>
                <span class="font-semibold">Do</span>
                <span class="font-semibold">Vr</span>
                <span class="font-semibold">Za</span>
                <span class="font-semibold">Zo</span>
            </div>
            <div class="grid grid-cols-7 text-center mt-4">
                @for (int day = 1; day <= getDaysInMonth() + (14 - getDaysInMonth() % 7); day++)
                {
                    DateTime date;
                    if (day <= getDaysInMonth())
                    {
                        date = new DateTime(currentDate.Year, currentDate.Month, day);
                        <span class="font-bold mt-4 select-none day-cell @GetDayClass(date)" data-date="@date.ToString("yyyy-MM-dd")" @onclick="() => SelectDay(date, false)">
                            @date.Day
                            @if (HasBookings(date))
                            {
                                <span class="inline-block w-2 h-2 bg-gray-300 rounded-full ml-1"></span>
                            }
                        </span>
                    }
                    else
                    {
                        int nextMonthDay = day - getDaysInMonth();
                        DateTime nextMonthDate = new DateTime(currentDate.Year, currentDate.Month, 1).AddMonths(1).AddDays(nextMonthDay - 1);
                        <span class="font-bold mt-4 text-gray-400 select-none day-cell @GetDayClass(nextMonthDate)" data-date="@nextMonthDate.ToString("yyyy-MM-dd")" @onclick="() => SelectDay(nextMonthDate, true)">
                            @nextMonthDate.Day
                            @if (HasBookings(nextMonthDate))
                            {
                                <span class="inline-block w-2 h-2 bg-gray-200 rounded-full ml-1"></span>
                            }
                        </span>
                    }
                }
            </div>
        </div>
        <div class="p-5">
            <div class="flex items-center space-x-4">
                <p>@currentDate.ToString("MMMM d yyyy")</p>
                <p>@startDay.ToString("MMMM d yyyy")</p>
                <p>@endDay.ToString("MMMM d yyyy")</p>
                <p>@startHour</p>
                <p>@endHour</p>
            </div>
        </div>
    </div>
</div>


@if (isModalVisible)
{
    <ReservationModal/>
}

@code {
    private bool isModalVisible = false;
    private DateTime currentDate = DateTime.Now;
    private int? startHour = null;
    private int? endHour = null;
    private bool isSelecting = false;
    private DateTime startDay = DateTime.Now;
    private DateTime endDay = DateTime.Now;
    private ProductDTO? product;
    private List<BookingDTO>? bookings;
    private Dictionary<DateTime, List<int>> bookedHoursByDate = new Dictionary<DateTime, List<int>>();

    protected override async Task OnInitializedAsync()
    {
        product = await ProductService.GetProductByBarcode(BarcodeService.Barcode);
        if (product != null)
        {
            bookings = await BookingService.GetBookingsByProductIdAsync(product.Id);
            InitializeBookedHours();
        }
    }
    private void InitializeBookedHours()
    {
        if (bookings == null) return;

        foreach (var booking in bookings)
        {
            DateTime current = booking.StartDate;
            while (current <= booking.EndDate)
            {
                if (!bookedHoursByDate.ContainsKey(current.Date))
                {
                    bookedHoursByDate[current.Date] = new List<int>();
                }

                int startHour = current.Date == booking.StartDate.Date ? booking.StartDate.Hour : 0;
                int endHour = current.Date == booking.EndDate.Date ? booking.EndDate.Hour : 23;

                for (int hour = startHour; hour <= endHour; hour++)
                {
                    if (!bookedHoursByDate[current.Date].Contains(hour))
                    {
                        bookedHoursByDate[current.Date].Add(hour);
                    }
                }

                current = current.AddDays(1);
            }
        }
    }
    private bool HasBooking(DateTime date)
    {
        return bookedHoursByDate.ContainsKey(date.Date);
    }

