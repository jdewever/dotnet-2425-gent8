@inject IJSRuntime JSRuntime
@using Rise.Shared.Products
@using Blazored.Toast.Services
@inject IProductService ProductService
@inject IBookingService BookingService
@inject BarcodeService BarcodeService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<div class="flex">
    <div class="p-5 w-1/2">
        <div class="flex justify-between mb-4">
            <h2 class="text-xl font-semibold mx-4">@currentDate.ToString("d MMMM yyyy")</h2>
            <div class="text-xl">
                @if(currentDate.Date > DateTime.Now.Date)
                {
                    <button class="px-2 py-1" @onclick="PreviousDate">&lt;</button>
                }
                <button class="px-2 py-1" @onclick="NextDate">&gt;</button>
            </div>
        </div>
        <div class="h-[calc(100vh-15rem)] overflow-y-auto mt-5 mx-10 no-scrollbar">
            <div class="grid grid-cols-1">
                @for (int hour = 0; hour < 24; hour++)
                {
                    int capturedHour = hour;
                    <div class="h-24 flex items-top cursor-pointer hour-cell" data-hour="@capturedHour" @onclick="() => SelectHour(capturedHour)">
                        <span class="font-bold w-16 select-none">@capturedHour:00</span>
                        <div class="flex-grow border-t border-gray-300 ml-4 @GetHourClass(capturedHour)  @GetHourSelectableClass()"></div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="p-5 w-1/2">
        <h2 class="text-xl text-center font-semibold mx-4">@currentDate.ToString("MMMM yyyy")</h2>
        <div class="h-1/3 overflow-y-auto mt-5 mx-10 no-scrollbar" id="calendarGrid">
            <div class="grid grid-cols-7 text-center">
                <span class="font-semibold">Ma</span>
                <span class="font-semibold">Di</span>
                <span class="font-semibold">Wo</span>
                <span class="font-semibold">Do</span>
                <span class="font-semibold">Vr</span>
                <span class="font-semibold">Za</span>
                <span class="font-semibold">Zo</span>
            </div>
            <div class="grid grid-cols-7 text-center mt-4">
                @for (int day = 1; day <= getDaysInMonth() + (14 - getDaysInMonth() % 7); day++)
                {
                    int capturedDay = (day - 1) % getDaysInMonth() + 1;
                    if (day <= getDaysInMonth())
                    {
                        <span class="font-bold mt-4 select-none day-cell @GetDayClass(day)" data-day="@day" @onclick="() => SelectDay(capturedDay, false)">@capturedDay</span>
                    }
                    else
                    {
                        <span class="font-bold mt-4 text-gray-400 select-none day-cell @GetDayClass(day)" data-day="@day" @onclick="() => SelectDay(capturedDay, true)">@capturedDay</span>
                    }
                }
            </div>
        </div>
        <div class="p-5">
            <div class="flex items-center space-x-4">
                <p>@currentDate.ToString("MMMM d yyyy")</p>
                <div class="flex items-center">
                    <select @bind="startHour" class="w-16 text-center">
                        @for (int hour = 0; hour < 24; hour++)
                        {
                            <option value="@hour">@hour:00</option>
                        }
                    </select>
                    <span class="mx-2">-</span>
                    <select @bind="endHour" class="w-16 text-center">
                        @for (int hour = (startHour ?? 0); hour < 24; hour++)
                        {
                            <option value="@hour">@hour:00</option>
                        }
                    </select>
                </div>
            </div>
            <p class="mr-4">@startDay</p>
            <p class="mr-4">@endDay</p>
             <div class="flex justify-center items-center">
                <button class="mt-4 w-1/3 px-4 py-2 bg-gray-300 rounded" @onclick="Reserve">Reserveer</button>
            </div>
        </div>
    </div>
</div>


@if (isModalVisible)
{
    <ReservationModal/>
}

@code {
    private bool isModalVisible = false;
    private DateTime currentDate = DateTime.Now;
    private int? startHour = null;
    private int? endHour = null;
    private bool isSelecting = false;
    private int? startDay = DateTime.Now.Day;
    private int? endDay = DateTime.Now.Day;
    private ProductDTO? product;
    private List<BookingDTO>? bookings;

    protected override async Task OnInitializedAsync()
    {
        product = await ProductService.GetProductByBarcode(BarcodeService.Barcode);
        if (product != null)
        {
            bookings = await BookingService.GetBookingsByProductIdAsync(product.Id);
        }
    }

    private async Task Reserve()
    {
    
        if (startDay.HasValue && endDay.HasValue && product != null)
        {
            var startDate = new DateTime(currentDate.Year, currentDate.Month, startDay.Value, startHour ?? 0, 0, 0);
            var endDate = new DateTime(currentDate.Year, currentDate.Month, endDay.Value, endHour+1 ?? 0, 0, 0);

            var booking = new BookingDTO
            {
                ProductId = product.Id,
                StartDate = startDate,
                EndDate = endDate,
                UserId = "TestId"
            };

            Console.WriteLine(startDate + " " + endDate);

            /*
            await BookingService.AddBookingAsync(booking);
            ToastService?.ShowSuccess("Reservatie succesvol aangemaakt");
            NavigationManager?.NavigateTo("/products");
            HideModal();
            await OnInitializedAsync(); 
            */
        }
    }

    
    private int getDaysInMonth()
    {
        return DateTime.DaysInMonth(currentDate.Year, currentDate.Month);
    }
    private void ShowModal()
    {
        isModalVisible = true;
    }

    private void HideModal()
    {
        isModalVisible = false;
    }

    private void PreviousDate()
    {
        currentDate = currentDate.AddDays(-1);
        endHour = null;
        startHour = null;
        startDay = currentDate.Day;
        endDay = currentDate.Day;
    }

    private void NextDate()
    {
        currentDate = currentDate.AddDays(1);
        startDay = currentDate.Day;
        endDay = currentDate.Day;
        endHour = null;
        startHour = null;
    }

    private string GetHourClass(int hour)
    {
        return startHour == null ? "" :
            endHour == null ? (hour == startHour ? "bg-blue-300 rounded-t-lg rounded-b-lg" : "") :
            hour == startHour && hour == endHour ? "bg-blue-300 rounded-t-lg rounded-b-lg" :
            hour == startHour ? "bg-blue-300 rounded-t-lg" :
            hour == endHour ? "bg-blue-300 rounded-b-lg" :
            (hour > startHour && hour < endHour) ? "bg-blue-300" : "";
    }
    private string GetDayClass(int day)
    {
        if (startDay == null)
        {
            return "";
        }

        if (endDay == null)
        {
            return day == startDay ? "bg-blue-300 rounded-t-lg rounded-b-lg" : "";
        }

        if (day == startDay && day == endDay)
        {
            return "bg-blue-300 rounded-t-lg rounded-b-lg";
        }

        if (day == startDay)
        {
            return "bg-blue-300 rounded-l-lg";
        }

        if (day == endDay)
        {
            return "bg-blue-300 rounded-r-lg";
        }

        return (day > startDay && day < endDay) ? "bg-blue-300" : "";
    }
    private string GetHourSelectableClass()
    {
        return !isSelecting && startDay != endDay ? "bg-gray-100 rounded" : "";
    }

    [JSInvokable]
    public void StartSelection()
    {
        if (startDay != endDay)
        {
            return;
        }

        isSelecting = true;
        startHour = null;
        endHour = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void EndSelection()
    {
        isSelecting = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void UpdateSelection(int hour)
    {
        if (isSelecting)
        {
            if (startHour == null)
            {
                startHour = hour;
            }
            else
            {
                if(hour < startHour)
                {
                    if(endHour == null)
                    {
                        endHour = startHour;
                        startHour = hour;
                    }else
                    {
                        startHour = hour;
                    }
                }else if(hour > startHour)
                {
                    endHour = hour;
                }
            }
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("dragSelection.startSelection", DotNetObjectReference.Create(this));
            await JSRuntime.InvokeVoidAsync("dragSelectDays.initialize", DotNetObjectReference.Create(this));
        }
    }
    private void SelectHour(int hour)
    {
        if (startDay != endDay)
        {
            return;
        }
        startHour = hour;
        endHour = hour;
        StateHasChanged();
    }
    private void SelectDay(int day, bool isNextMonth)
    {
        if (isNextMonth)
        {
            currentDate = new DateTime(currentDate.Year, currentDate.Month, day).AddMonths(1);
        }
        else
        {
            currentDate = new DateTime(currentDate.Year, currentDate.Month, day);
        }
        startDay = day;
        endDay = day;
        StateHasChanged();
    }
    
    [JSInvokable]
    public void StartDaySelection(int day)
    {
        isSelecting = true;
        startDay = day;
        endDay = null;
        startHour = null;
        endHour = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void EndDaySelection()
    {
        isSelecting = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void UpdateDaySelection(int day)
    {
        if (isSelecting)
        {
            if(day < startDay)
            {
                if(endDay == null)
                {
                    endDay = startDay;
                    startDay = day;
                }else
                {
                    startDay = day;
                }
            }else if(day > startDay)
            {
                endDay = day;
            }
            StateHasChanged();
        }
    }
}