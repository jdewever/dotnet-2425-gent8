@using Rise.Client.Components.Table
@using Rise.Shared.Products

@* Desktop Skeleton Loader *@
<div class="hidden lg:block min-w-full">
    <table class="table-auto border-collapse border border-gray-200 rounded-lg overflow-hidden w-full min-w-full">
        <thead class="bg-gray-200">
            <tr>
                @for (int i = 0; i < ColumnCount; i++)
                {
                    <th
                        class="px-4 py-2 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">
                        <div class="bg-gray-300 animate-pulse h-4 w-3/4 rounded"></div>
                    </th>
                }
                <th
                    class="px-4 py-2 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">
                    <div class="bg-gray-300 animate-pulse h-4 w-1/2 rounded"></div>
                </th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < RowCount; i++)
            {
                <tr>
                    @for (int j = 0; j < ColumnCount; j++)
                    {
                        <td class="px-4 py-2 border-b border-gray-200">
                            <div class="bg-gray-300 animate-pulse h-4 w-full rounded"></div>
                        </td>
                    }
                    <td class="px-4 py-2 border-b border-gray-200">
                        <div class="bg-gray-300 animate-pulse h-4 w-1/2 rounded"></div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Mobile Skeleton Loader *@
<div class="lg:hidden w-full">
    @for (int i = 0; i < RowCount; i++)
    {
        <div class="bg-white shadow-md rounded-lg p-4 mb-4 w-full mx-auto">
            <div class="bg-gray-300 animate-pulse h-4 w-3/4 mb-2 rounded"></div>
            <div class="bg-gray-300 animate-pulse h-4 w-1/2 mb-2 rounded"></div>
            <div class="bg-gray-300 animate-pulse h-4 w-1/3 rounded"></div>
        </div>
    }
</div>