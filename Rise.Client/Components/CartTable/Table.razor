<div class="overflow-x-auto w-full">
    <!-- Desktop Table View (hidden on small screens) -->
    <div class="hidden lg:block min-w-full">
        <table class="table-auto border-collapse border border-gray-200 rounded-lg overflow-hidden w-full min-w-full">
            <thead class="bg-gray-200">
                <tr>
                    <th class="px-4 py-2 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">
                        Naam
                    </th>
                    <th class="px-4 py-2 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">
                        Hoeveelheid
                    </th>
                    <th class="px-4 py-2 border-b border-gray-200 text-left text-xs font-medium text-gray-500 tracking-wider">
                        Verwijderen
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cartItem in Items)
                {
                    <tr class="hover:bg-gray-100" @onclick="() => OnRowClick(cartItem)">
                        <td class="px-4 py-2 border-b border-gray-200 text-sm text-gray-700 hidden lg:table-cell">
                            @cartItem.Product.Name
                        </td>
                        <td class="px-4 py-2 border-b border-gray-200 text-sm hidden lg:table-cell @(cartItem.Valid ? "text-gray-700" : "text-red-700")">
                            @cartItem.Quantity
                        </td>
                        <td class="px-4 py-2 border-b border-gray-200 text-sm text-gray-700 hidden lg:table-cell text-center">
                            <button @onclick:stopPropagation @onclick="() => OnRemoveProduct(cartItem)" class="text-red-600 hover:text-red-800">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M9 3h6a1 1 0 011 1v1h3a1 1 0 110 2h-1v12a2 2 0 01-2 2H8a2 2 0 01-2-2V7H5a1 1 0 110-2h3V4a1 1 0 011-1zm-1 5v10m4-10v10m4-10v10" />
                                </svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- Mobile Card View (visible on small screens) -->
    <div class="block lg:hidden space-y-4">
        @foreach (var cartItem in Items)
        {
            <div class="border border-gray-200 rounded-lg p-4 shadow-md">
                <div class="flex justify-between items-center mb-2">
                    <h3 class="text-sm font-medium text-gray-700">Naam</h3>
                    <p class="text-sm text-gray-900">@cartItem.Product.Name</p>
                </div>
                <div class="flex justify-between items-center mb-2">
                    <h3 class="text-sm font-medium text-gray-700">Hoeveelheid</h3>
                    <p class="text-sm @(cartItem.Valid ? "text-gray-900" : "text-red-700")">@cartItem.Quantity</p>
                </div>
                <div class="flex justify-end">
                    <button @onclick="() => OnRemoveProduct(cartItem)" class="text-red-600 hover:text-red-800 flex items-center space-x-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 3h6a1 1 0 011 1v1h3a1 1 0 110 2h-1v12a2 2 0 01-2 2H8a2 2 0 01-2-2V7H5a1 1 0 110-2h3V4a1 1 0 011-1zm-1 5v10m4-10v10m4-10v10" />
                        </svg>
                        <span>Verwijderen</span>
                    </button>
                </div>
            </div>
        }
    </div>
</div>