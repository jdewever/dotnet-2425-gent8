@inherits ProductModal

<div class="overflow-x-auto w-full">
    <div class="hidden lg:block min-w-full">
        <table class="table-auto border-collapse border border-gray-200 rounded-lg overflow-hidden w-full min-w-full">
            <thead class="bg-gray-200">
                <tr>
                    @Columns
                    <th>&nbsp;</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Items)
                {
                    <CascadingValue Value="product">
                        <tr class="hover:bg-gray-100" @onclick="EnableModal ? () => ShowModal(product) : () => {}">
                            @Columns
                            <td class="border-b border-gray-200 lg:table-cell">
                                <button name="uitlenenBtn"
                                    class="bg-gray-200 text-gray-700 text-xs px-2 py-1 rounded-full hover:bg-gray-300" @onclick="() => OnUitlenenClick(product)">
                                    Uitlenen
                                </button>
                            </td>
                        </tr>
                    </CascadingValue>
                }
            </tbody>
        </table>
    </div>

    <div class="lg:hidden w-full">
        @foreach (var product in Items)
        {
            <div class="bg-white shadow-md rounded-lg p-4 mb-4 w-full mx-auto relative" @onclick="EnableModal ? () => ShowModal(product) : () => {}">
                <CascadingValue Value="product">
                    @Columns
                    <button name="uitlenenBtn"
                        class="bg-gray-200 text-gray-700 text-xs px-2 py-1 rounded-full hover:bg-gray-300" @onclick="() => OnUitlenenClick(product)">
                        Uitlenen
                    </button>
                </CascadingValue>
            </div>
        }
    </div>
</div>

@if (isModalVisible && selectedProduct != null)
{
    <ProductDetailModal SelectedProduct="@selectedProduct" OnClick="CloseModal" />
}