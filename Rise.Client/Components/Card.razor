<div id="@ID" class="flex bg-gray-100 rounded-xl p-4 justify-between items-center">
    <div class="flex items-center space-x-4">
        <span class="text-xl font-bold text-slate-900">@Value</span>
        <span class="text-lg font-light text-slate-500">@Title</span>
    </div>

    <img src="@IconUrl" alt="@Title icon" class="h-8 w-8 object-contain m-2">
</div>
