@page "/reservations"
@attribute [Authorize]
@using Rise.Client.Pages.Reservation.Components
@using Rise.Client.Components.Buttons

<PageTitle>Reserveringen</PageTitle>

<body>
    <section class="flex justify-between items-center">
        <h1 class="text-2xl font-light py-8">Reserveringen</h1>
        <div class="mr-10 mt-4">
            <ToggleButton OnClick="@ToggleHistory" />
        </div>
    </section>

    <div class="w-full">
        @if (Reservations == null)
        {
            <p>Loading...</p>
        }
        else
        {
            <ReservationsTable Reservations="Reservations" OnCancel="HandleCancellation" ShowHistory="IsHistory" />
        }
    </div>
</body>