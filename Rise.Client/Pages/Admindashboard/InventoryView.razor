@using Rise.Client.Components
@using Rise.Client.Components.Table
@using Rise.Shared.Products

<div class="w-full" style="height: 70vh;">
    @if (Dashboard == null)
    {
        <p>
            <TableSkeleton ColumnCount="3" RowCount="5" />
        </p>
    }
    else
    {
        <div class="grid grid-cols-1 space-y-2 lg:space-y-0 lg:grid-cols-3 lg:space-x-2">
            <Card Title="In kritieke voorraad" Value="@LowStockProductCount" IconUrl="/images/icons/warning.svg" />
            <Card Title="Vandaag uitgeleend" Value="@ProductsReserverd" IconUrl="/images/icons/out.svg" />
            <Card Title="Vandaag terug te brengen" Value="@ProductsReturning" IconUrl="/images/icons/calendar.svg" />
        </div>
        <h1 class="text-2xl font-light py-8">Producten met beperkte voorraad</h1>
        <Table Items="Dashboard.LowStockProducts">
            <Columns>
                <Column T="ProductDTO" Value="Barcode" Title="Barcode" />
                <Column T="ProductDTO" Value="Name" Title="Naam" />
                <Column T="ProductDTO" Value="QuantityInStock" Title="Aantal in stock" />
                <Column T="ProductDTO" Value="QuantityOnOrder" Title="Aantal in bestelling" />
                <Column T="ProductDTO" Value="LowStock" Title="Minimum gewenste voorraad" />
            </Columns>
        </Table>
    }
</div>