@page "/"
@attribute [Authorize]
@using Rise.Client.Pages

<PageTitle>Dashboard</PageTitle>

<AuthorizeView Roles="Administrator">
    <Authorized>
        @* should be user management *@
        <InventoryView />
    </Authorized>
    <NotAuthorized>
        <AuthorizeView Roles="Inventory Manager" Context="innerContext">
            <Authorized>
                <InventoryView />
            </Authorized>
            <NotAuthorized>
                <RedirectToProducts />
            </NotAuthorized>
        </AuthorizeView>
    </NotAuthorized>
</AuthorizeView>
