@layout LoginLayout
@page "/"
@inject NavigationManager Navigation

<div class="flex h-screen">
    <!-- Left Panel (hidden on smaller screens) -->
    <div class="bg-gray-800 text-white w-1/2 lg:flex hidden justify-center items-center">
        <h1 class="text-5xl font-bold">360° ZORG</h1>
    </div>

    <!-- Right Panel (takes full width on small screens) -->
    <div class="w-full lg:w-1/2 flex justify-center items-center p-6">
        <div class="w-full max-w-md">
            <!-- Logo -->
            <div class="flex justify-center mb-8">
                <img src="/images/logoHogentLogin.jpg" alt="HoGent Logo" class="w-64 max-w-full h-auto">
            </div>

            <!-- Form -->
            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" class="space-y-6">
                <!-- Email Input -->
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                    <InputText id="email" @bind-Value="loginModel.Email" class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-gray-500 focus:border-gray-500" />
                </div>

                <!-- Password Input -->
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700">Wachtwoord</label>
                    <InputText id="password" @bind-Value="loginModel.Password" type="password" class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-gray-500 focus:border-gray-500" />
                </div>

                <!-- Login Button and Forgot Password Link -->
                <div class="flex items-center justify-between mt-6">
                    <!-- Login Button -->
                    <button type="submit" class="w-1/3 bg-gray-500 text-white px-3 py-2 rounded-full hover:bg-gray-700 transition">
                        Login
                    </button>

                    <!-- Forgot Password Link -->
                    <a href="/forgot-password" class="text-sm text-gray-500 hover:text-gray-700 transition ml-4">Wachtwoord vergeten?</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();

    private void HandleLogin()
    {
        // Moet nog code komen
        Navigation.NavigateTo("/index");
    }

    public class LoginModel
    {
        public string Email { get; set; } = String.Empty;
        public string Password { get; set; } = String.Empty;
    }
}
