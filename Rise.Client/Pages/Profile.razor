@page "/Profile"
@using Rise.Client.Profile
@attribute [Authorize]

@if (!_loading)
{
    <div class="mb-4">
        <ProfileDetails User="User"/>
    </div>
    <div class="flex flex-row justify-between">
        <Transactions TransactionsList="TransactionsList"/>
        <Reservations/>
    </div>
}
else
{
    <p>
        <em>Loading...</em>
    </p>
}