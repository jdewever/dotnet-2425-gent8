@page "/Profile"
@using Rise.Client.Profile
@attribute [Authorize]

@if (!_loading)
{
    <div class="mb-4">
        <ProfileDetails User="User"/>
    </div>
    <div class="grid xl:grid-cols-2 gap-2 grid-cols-1">
        <div class="p-2 w-full">
            <Transactions TransactionsList="TransactionsList"/>
        </div>
        <div class="p-2 w-full">
            <Reservations BookingsList="BookingsList"/>
        </div>
    </div>
}
else
{
    <p>
        <em>Laden...</em>
    </p>
}