@page "/scan/{barcode?}"
@attribute [Authorize]
@using Blazored.LocalStorage
@using Rise.Client.Products
@using Rise.Shared.Products
@inject ILocalStorageService localStorage

<PageTitle>Scannen</PageTitle>


<div class="flex flex-col lg:flex-row w-full items-center space-x-4">
    
    <ScanProduct Product="selectedProduct" AddProduct="addProduct" GetProductCountByBarcode="getProductCountByBarcode"/>
    <ScanTable Products="products"/>
    
</div>

@code {
    private Dictionary<ProductDTO,int> products = new();
    private ProductDTO? selectedProduct = null;

    [Parameter] public string? Barcode { get; set; }

    [Inject] public required IProductService ProductService { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Barcode))
        {
            selectedProduct = await ProductService.GetProductByBarcode(Barcode);
        }

        var storedProducts = await localStorage.GetItemAsync<Dictionary<ProductDTO, int>>("products");
        if (storedProducts != null)
        {
            products = storedProducts;
        }
    }

    private async Task addProduct((ProductDTO product, int quantity) productInfo)
    {
        products[productInfo.product] = productInfo.quantity;
        await localStorage.SetItemAsync("products", products);
    }

    private int getProductCountByBarcode(string barcode)
    {
        return barcode != "" ? products.Where(p => p.Key.Barcode == barcode).Sum(p => p.Value) : 0;
    }
}