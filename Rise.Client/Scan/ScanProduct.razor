<script>
    function validateNumericInput(event) {
        const input = event.target;
        input.value = input.value.replace(/[^0-9]/g, '');
    }
</script>

<!-- Left Column-->
<div class="flex flex-col items-center w-full lg:w-1/2">
    <!-- In Stock-->
    <div class="w-1/2 flex justify-between mb-4">
        <label class="text-gray-500">In stock</label>
        <label class="text-gray-500 quantity-in-stock">@(((Product?.QuantityInStock).ToString() ?? "/"))</label>
    </div>
    
    <div class="flex flex-col items-center w-full xl:w-1/2 bg-gray-100 rounded-lg p-8 mb-4" style="height: 50vh;">
         @if (Product == null)
        {
            <span class="text-gray-500 text-xl">Product ingeven ...</span>
        }
        else
        {
            <img src="images/testafbeelding.png" alt="Product Image" class="h-full w-auto object-contain" />
        }
    </div>

    <!-- Barcode Input -->
    <div class="w-full flex flex-col items-center space-y-2 mb-4">
        <label class="text-gray-500">Barcode</label>
        <div class="relative w-1/2">
            <input class="w-full border border-gray-300 rounded-lg p-2 pr-10" type="text" placeholder="123456789" @bind="@BarcodeService.Barcode" oninput="validateNumericInput(event)"/>
            <svg class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
        </div>
    </div>


    <!-- Quantity Selector -->
    <div class="flex items-center space-x-2">
        <button class="text-xl font-bold @(Quantity < 100 || Product == null ? "text-gray-400" : "text-gray-600")" @onclick="() => Quantity -= 100" disabled="@(Quantity < 100 || Product == null)">-100</button>
        <button class="text-xl font-bold @(Quantity < 10 || Product == null ? "text-gray-400" : "text-gray-600")" @onclick="() => Quantity -= 10" disabled="@(Quantity < 10 || Product == null)">-10</button>
        <button class="text-xl font-bold @(Quantity <= 0 || Product == null ? "text-gray-400" : "text-gray-600")" @onclick="() => Quantity--" disabled="@(Quantity <= 0 || Product == null)">-1</button>
        <span class="text-xl w-16 text-center">@Quantity</span>
        <button class="text-xl font-bold @(Product == null ? "text-gray-400" : "text-gray-600")" @onclick="() => Quantity++" disabled="@(Product == null)">+1</button>
        <button class="text-xl font-bold @(Product == null ? "text-gray-400" : "text-gray-600")" @onclick="() => Quantity += 10" disabled="@(Product == null)">+10</button>
        <button class="text-xl font-bold @(Product == null ? "text-gray-400" : "text-gray-600")" @onclick="() => Quantity += 100" disabled="@(Product == null)">+100</button>
    </div>

    <!-- Add Button -->
    <button class="mt-4 px-6 py-2 bg-gray-300 text-gray-600 rounded-lg @((Product?.QuantityInStock - GetProductCount() == 0 || Quantity <= 0) ? "disabled cursor-not-allowed" : "")" @onclick="OnAddProduct">Voeg toe</button>
    
</div>
