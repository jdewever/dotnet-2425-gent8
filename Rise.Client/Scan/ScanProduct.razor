<script>
    function validateNumericInput(event) {
        const input = event.target;
        input.value = input.value.replace(/[^0-9]/g, '');
    }
</script>

@if (ShowQuantityModal && IsMobileView)
{
    <div className="min-h-screen w-full bg-gray-900">
        <div class="fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-50 p-4">
            <div class="bg-white rounded-lg shadow-2xl p-6 w-full max-w-xs text-center space-y-4">
                <h2 class="text-2xl font-semibold text-gray-800">Aantal</h2>

                <!-- Productnaam weergeven in de pop-up -->
                @if (Product != null)
                {
                    <p class="text-lg text-gray-600">Product: <span class="text-gray-900 font-semibold">@Product.Name</span></p>
                }

                <!-- Aantal Selector -->
                <div class="flex items-center justify-around space-x-3">
                    <button
                        class="text-lg font-bold text-white bg-red-500 w-12 h-12 rounded-full flex items-center justify-center focus:outline-none"
                        @onclick="() => Quantity -= 10" disabled="@(Quantity < 10)">
                        -10
                    </button>
                    <button
                        class="text-lg font-bold text-white bg-red-500 w-12 h-12 rounded-full flex items-center justify-center focus:outline-none"
                        @onclick="() => Quantity--" disabled="@(Quantity <= 0)">
                        -1
                    </button>

                    <span class="text-3xl font-bold text-gray-800 w-20 text-center">@Quantity</span>

                    <button
                        class="text-lg font-bold text-white bg-green-500 w-12 h-12 rounded-full flex items-center justify-center focus:outline-none"
                        @onclick="() => Quantity++">
                        +1
                    </button>
                    <button
                        class="text-lg font-bold text-white bg-green-500 w-12 h-12 rounded-full flex items-center justify-center focus:outline-none"
                        @onclick="() => Quantity += 10">
                        +10
                    </button>
                </div>

                <!-- Bevestigen en Annuleren Knoppen -->
                <div class="flex flex-col items-center space-y-3">
                    <button
                        class="w-full px-4 py-3 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                        @onclick="OnAddProduct">
                        Bevestigen
                    </button>
                    <button class="text-sm text-gray-500 underline"
                        @onclick="() => { ShowQuantityModal = false; ShowScanner = true; }">Annuleren</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Left Column-->
<div class="flex flex-col items-center w-full lg:w-1/2">
    @if (!IsMobileView)
    {
        <!-- In Stock-->
        <div class="w-1/2 flex justify-between mb-4">
            <label class="text-gray-500">In stock</label>
            <label class="text-gray-500 quantity-in-stock">@(((Product?.QuantityInStock).ToString() ?? "/"))</label>
        </div>

        <div class="flex flex-col items-center w-full xl:w-1/2 bg-gray-100 rounded-lg p-8 mb-4" style="height: 50vh;">
            @if (Product == null)
            {
                <span class="text-gray-500 text-xl">Product ingeven ...</span>
            }
            else
            {
                <img src="images/testafbeelding.png" alt="Product Image" class="h-full w-auto object-contain" />
            }
        </div>

        <!-- Barcode Input -->
        <div class="w-full flex flex-col items-center space-y-2 mb-4">
            <label class="text-gray-500">Barcode</label>
            <div class="relative w-1/2">
                <input class="w-full border border-gray-300 rounded-lg p-2 pr-10" type="text" placeholder="123456789"
                    @bind="@ScanService.Barcode" oninput="validateNumericInput(event)" />
                <svg class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 size-6"
                    xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
            </div>
        </div>

        <!-- Quantity Selector -->
        <div class="flex flex-col items-center space-y-4">
            <span class="text-3xl font-bold text-center">@Quantity</span>
            <div class="flex items-center justify-center space-x-10">
                <div class="flex items-center space-x-2">
                    <button
                        class="text-xl font-bold w-10 @(Quantity < 100 || Product == null ? "text-gray-400" : "text-gray-600")"
                        @onclick="() => Quantity -= 100" disabled="@(Quantity < 100 || Product == null)">-100</button>
                    <button
                        class="text-xl font-bold w-10 @(Quantity < 10 || Product == null ? "text-gray-400" : "text-gray-600")"
                        @onclick="() => Quantity -= 10" disabled="@(Quantity < 10 || Product == null)">-10</button>
                    <button
                        class="text-xl font-bold w-10 @(Quantity <= 0 || Product == null ? "text-gray-400" : "text-gray-600")"
                        @onclick="() => Quantity--" disabled="@(Quantity <= 0 || Product == null)">-1</button>
                </div>
                <div class="flex items-center space-x-2">
                    <button class="text-xl font-bold w-10 @(Product == null ? "text-gray-400" : "text-gray-600")"
                        @onclick="() => Quantity++" disabled="@(Product == null)">+1</button>
                    <button class="text-xl font-bold w-10 @(Product == null ? "text-gray-400" : "text-gray-600")"
                        @onclick="() => Quantity += 10" disabled="@(Product == null)">+10</button>
                    <button class="text-xl font-bold w-10 @(Product == null ? "text-gray-400" : "text-gray-600")"
                        @onclick="() => Quantity += 100" disabled="@(Product == null)">+100</button>
                </div>
            </div>
        </div>

        <!-- Add Button -->
        <button
            class="mt-4 px-6 py-2 bg-gray-300 text-gray-600 rounded-lg @((Product?.QuantityInStock - GetProductCount() == 0 || Quantity <= 0) ? "disabled cursor-not-allowed" : "")"
            @onclick="OnAddProduct">Voeg toe</button>
    }
    else if (IsMobileView && ShowScanner)
    {
        <div class="w-full lg:w-2/3 bg-white rounded-lg shadow-md p-2 flex-grow">
            <div class="w-full h-[60vh] max-h-[245px] flex justify-center items-center rounded-lg">
                <BlazorBarcodeScanner.ZXing.JS.BarcodeReader Title="" StartCameraAutomatically="true" ShowStart="false"
                    ShowStop="false" ShowReset="false" ShowToggleTorch="true" ShowResult="false" ShowVideoDeviceList="false"
                    OnBarcodeReceived="LocalReceivedBarcodeText" />
            </div>
        </div>
    }
</div>
