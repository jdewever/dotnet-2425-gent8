@using Rise.Client.Components.CartTable


<!-- Right Column -->
<div class="flex flex-col lg:w-1/2 w-full items-center p-2">


    <div class="relative w-full lg:w-2/5 mb-4">
        <div class="absolute inset-0 flex">
            <div class="w-1/2 bg-gray-300 rounded-lg transition-transform duration-300" style="transform: translateX(@(selectedButton ? "0%" : "100%"))"></div>
        </div>
        <div class="relative z-10 flex w-full">
            <button class="w-1/2 px-3 py-2 text-gray-600 rounded-lg text-sm md:text-base" @onclick='() => SelectButton(true)'>Scan uit</button>
            <button class="w-1/2 px-3 py-2 text-gray-600 rounded-lg text-sm md:text-base" @onclick='() => SelectButton(false)'>Scan in</button>
        </div>
    </div>

    <div class="w-full h-96 lg:h-[70vh] mb-4">
        <Table Items="CartItems" RemoveProduct="RemoveProduct" />
    </div>

    <div class="mt-4 text-red-700 min-h-[1.5rem] text-center lg:text-left">
        @if (CartItems.Any(item => !item.Valid))
        {
            <h3 class="font-bold">Niet alle producten in stock</h3>
        }
    </div>

    <div class="flex flex-col lg:flex-row justify-between w-full lg:w-auto space-y-4 lg:space-y-0 lg:space-x-4 mt-4 items-center">
        <button class="w-full lg:w-auto px-6 py-3 bg-gray-300 text-gray-600 rounded-lg @(CartItems == null || !CartItems.Any() ? "disabled cursor-not-allowed" : "")"
                @onclick="@(selectedButton ? (() => CheckoutCart()) : (() => CheckInCart()))">
            Bevestig
        </button>
    </div>
</div>